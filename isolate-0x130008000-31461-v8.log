script-source,592,node:internal/crypto/mac,'use strict';\n\nconst {\n  ArrayFrom\x2C\n  SafeSet\x2C\n} = primordials;\n\nconst {\n  HmacJob\x2C\n  KeyObjectHandle\x2C\n  kCryptoJobAsync\x2C\n  kSignJobModeSign\x2C\n  kSignJobModeVerify\x2C\n} = internalBinding('crypto');\n\nconst {\n  getBlockSize\x2C\n  hasAnyNotIn\x2C\n  jobPromise\x2C\n  normalizeHashName\x2C\n  validateKeyOps\x2C\n  kHandle\x2C\n  kKeyObject\x2C\n} = require('internal/crypto/util');\n\nconst {\n  lazyDOMException\x2C\n  promisify\x2C\n} = require('internal/util');\n\nconst {\n  generateKey: _generateKey\x2C\n} = require('internal/crypto/keygen');\n\nconst {\n  InternalCryptoKey\x2C\n  SecretKeyObject\x2C\n  createSecretKey\x2C\n  kAlgorithm\x2C\n} = require('internal/crypto/keys');\n\nconst generateKey = promisify(_generateKey);\n\nasync function hmacGenerateKey(algorithm\x2C extractable\x2C keyUsages) {\n  const { hash\x2C name } = algorithm;\n  let { length } = algorithm;\n\n  if (length === undefined)\n    length = getBlockSize(hash.name);\n\n  const usageSet = new SafeSet(keyUsages);\n  if (hasAnyNotIn(usageSet\x2C ['sign'\x2C 'verify'])) {\n    throw lazyDOMException(\n      'Unsupported key usage for an HMAC key'\x2C\n      'SyntaxError');\n  }\n\n  const key = await generateKey('hmac'\x2C { length }).catch((err) => {\n    throw lazyDOMException(\n      'The operation failed for an operation-specific reason'\x2C\n      { name: 'OperationError'\x2C cause: err });\n  });\n\n  return new InternalCryptoKey(\n    key\x2C\n    { name\x2C length\x2C hash }\x2C\n    ArrayFrom(usageSet)\x2C\n    extractable);\n}\n\nfunction hmacImportKey(\n  format\x2C\n  keyData\x2C\n  algorithm\x2C\n  extractable\x2C\n  keyUsages\x2C\n) {\n  const usagesSet = new SafeSet(keyUsages);\n  if (hasAnyNotIn(usagesSet\x2C ['sign'\x2C 'verify'])) {\n    throw lazyDOMException(\n      'Unsupported key usage for an HMAC key'\x2C\n      'SyntaxError');\n  }\n  let keyObject;\n  switch (format) {\n    case 'KeyObject': {\n  