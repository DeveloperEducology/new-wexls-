code-creation,Script,9,300917,0x2595f6a73000,54, file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/BarGraph.js:1:1,0x2d65d17bfdf8,~
script-source,558,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/BarGraph.js,import { COLORS\x2C SVG_DEFS\x2C resolveColor } from './defs.js';\n\nexport function renderBarGraph(props\x2C rng) {\n  const title = props.title || '';\n  const categories = props.categories ? String(props.categories).split('\x2C').map(s => s.trim()) : ['Red'\x2C 'Blue'\x2C 'Green'];\n  const values = props.values ? String(props.values).split('\x2C').map(Number).map(v => isNaN(v) ? 0 : v) : [4\x2C 7\x2C 3];\n  \n  const maxVal = Math.max(...values\x2C 1);\n  const yMax = Number(props.yMax) !== undefined && !isNaN(Number(props.yMax)) ? Number(props.yMax) : Math.ceil(maxVal * 1.2);\n  const color = props.color || 'blue';\n\n  const theme = resolveColor(color\x2C COLORS\x2C rng);\n\n  const width = 450;\n  const height = 300;\n  const padLeft = 45;\n  const padRight = 20;\n  const padTop = 40;\n  const padBottom = 45;\n\n  const graphW = width - padLeft - padRight;\n  const graphH = height - padTop - padBottom;\n\n  let yAxisGrid = '';\n  // Draw Y grid lines and labels\n  const yTicksCount = 5;\n  for (let i = 0; i <= yTicksCount; i++) {\n    const tickVal = Math.round((yMax / yTicksCount) * i);\n    const y = padTop + graphH - (tickVal / yMax) * graphH;\n    \n    yAxisGrid += `\n      <!-- Grid line -->\n      <line x1="${padLeft}" y1="${y}" x2="${width - padRight}" y2="${y}" stroke="#e2e8f0" stroke-width="1" />\n      <!-- Label -->\n      <text x="${padLeft - 8}" y="${y + 4}" font-family="system-ui\x2C sans-serif" font-size="11px" font-weight="700" fill="#64748b" text-anchor="end">${tickVal}</text>\n    `;\n  }\n\n  // Draw Bars and X-axis labels\n  let barsMarkup = '';\n  const colCount = categories.length;\n  const colWidth = graphW / colCount;\n  const barWidth = colWidth * 0.6; // 60% of column width\n\n  for (let i = 0; i < colCount; i++) {\n    const cat = categories[i];\n    const val = values[i] || 0;\n    const barH = (val / yMax) * graphH;\n    \n    const x = padLeft + i * colWidth + (colWidth - barWidth) / 2;\n    const y = padTop + graphH - barH;\n\n    barsMarkup += `\n      <!-- Bar -->\n      <rect x="${x}" y="${y}" width="${barWidth}" height="${barH}" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="2.5" rx="4" filter="url(#shadow)" />\n      <!-- Value text on top of bar -->\n      ${val > 0 ? `\n        <text x="${x + barWidth / 2}" y="${y - 6}" font-family="system-ui\x2C sans-serif" font-size="12px" font-weight="900" fill="${theme.stroke}" text-anchor="middle">${val}</text>\n      ` : ''}\n      <!-- Category Label -->\n      <text x="${padLeft + i * colWidth + colWidth / 2}" y="${padTop + graphH + 20}" font-family="system-ui\x2C sans-serif" font-size="11px" font-weight="700" fill="#475569" text-anchor="middle">${cat}</text>\n    `;\n  }\n\n  const titleMarkup = title ? `\n    <text x="${width / 2}" y="${22}" font-family="system-ui\x2C sans-serif" font-size="14px" font-weight="900" fill="#1e293b" text-anchor="middle">${title}</text>\n  ` : '';\n\n  const axes = `\n    <!-- Y Axis -->\n    <line x1="${padLeft}" y1="${padTop}" x2="${padLeft}" y2="${padTop + graphH}" stroke="#94a3b8" stroke-width="2.5" />\n    <!-- X Axis -->\n    <line x1="${padLeft}" y1="${padTop + graphH}" x2="${width - padRight}" y2="${padTop + graphH}" stroke="#94a3b8" stroke-width="2.5" />\n  `;\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: ${width}px; display: block; margin: 10px auto;">\n      ${SVG_DEFS}\n      <rect x="5" y="5" width="${width - 10}" height="${height - 10}" rx="12" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" filter="url(#shadow)" />\n      ${titleMarkup}\n      ${yAxisGrid}\n      ${barsMarkup}\n      ${axes}\n    </svg>\n  `.trim();\n}\n
