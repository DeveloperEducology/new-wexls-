script-source,278,node:internal/crypto/webcrypto,'use strict';\n\nconst {\n  ArrayPrototypeIncludes\x2C\n  JSONParse\x2C\n  JSONStringify\x2C\n  ObjectDefineProperties\x2C\n  ReflectApply\x2C\n  ReflectConstruct\x2C\n  StringPrototypeRepeat\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeStartsWith\x2C\n  SymbolToStringTag\x2C\n} = primordials;\n\nconst {\n  kWebCryptoKeyFormatRaw\x2C\n  kWebCryptoKeyFormatPKCS8\x2C\n  kWebCryptoKeyFormatSPKI\x2C\n  kWebCryptoCipherEncrypt\x2C\n  kWebCryptoCipherDecrypt\x2C\n} = internalBinding('crypto');\n\nconst { TextDecoder\x2C TextEncoder } = require('internal/encoding');\n\nconst {\n  codes: {\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  createPublicKey\x2C\n  CryptoKey\x2C\n  importGenericSecretKey\x2C\n  kAlgorithm\x2C\n  kKeyUsages\x2C\n  kExtractable\x2C\n  kKeyType\x2C\n} = require('internal/crypto/keys');\n\nconst {\n  asyncDigest\x2C\n} = require('internal/crypto/hash');\n\nconst {\n  getBlockSize\x2C\n  normalizeAlgorithm\x2C\n  normalizeHashName\x2C\n  validateMaxBufferLength\x2C\n  kHandle\x2C\n  kKeyObject\x2C\n} = require('internal/crypto/util');\n\nconst {\n  emitExperimentalWarning\x2C\n  kEnumerableProperty\x2C\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst {\n  getRandomValues: _getRandomValues\x2C\n  randomUUID: _randomUUID\x2C\n} = require('internal/crypto/random');\n\nlet webidl;\n\nasync function digest(algorithm\x2C data) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'digest' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  data = webidl.converters.BufferSource(data\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'digest');\n\n  return ReflectApply(asyncDigest\x2C this\x2C [algorithm\x2C data]);\n}\n\nfunction randomUUID() {\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n  return _randomUUID();\n}\n\nasync function generateKey(\n  algorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'generateKey' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 3\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  extractable = webidl.converters.boolean(extractable\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\n    prefix\x2C\n    context: '3rd argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'generateKey');\n  let result;\n  let resultType;\n  switch (algorithm.name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/rsa')\n        .rsaKeyGenerate(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/cfrg')\n        .cfrgGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/ec')\n        .ecGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'HMAC':\n      resultType = 'CryptoKey';\n      result = await require('int