script-source,508,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/index.js,import { renderTenFrame } from './TenFrame.js';\nimport { renderJarOfMarbles } from './JarOfMarbles.js';\nimport { renderSpinner } from './Spinner.js';\nimport { renderItemCounter } from './ItemCounter.js';\nimport { renderImage } from './Image.js';\nimport { drawVisualChoicePanel } from './VisualChoice.js';\nimport { renderSceneComposer } from './SceneComposer.js';\nimport { renderPlaceValue } from './PlaceValue.js';\n\n// New Phase 1 Components\nimport { renderNumberLine } from './NumberLine.js';\nimport { renderHundredChart } from './HundredChart.js';\nimport { renderRekenrek } from './Rekenrek.js';\nimport { renderNumberBond } from './NumberBond.js';\nimport { renderTallyChart } from './TallyChart.js';\nimport { renderFractionBar } from './FractionBar.js';\nimport { renderFractionCircle } from './FractionCircle.js';\nimport { renderFractionGrid } from './FractionGrid.js';\nimport { renderDecimalGrid } from './DecimalGrid.js';\nimport { renderDecimalLine } from './DecimalLine.js';\nimport { renderShapeCanvas } from './ShapeCanvas.js';\nimport { renderCoordinatePlane } from './CoordinatePlane.js';\nimport { renderProtractor } from './Protractor.js';\nimport { renderRuler } from './Ruler.js';\nimport { renderGeoboard } from './Geoboard.js';\nimport { renderBarGraph } from './BarGraph.js';\nimport { renderPictograph } from './Pictograph.js';\nimport { renderFrequencyTable } from './FrequencyTable.js';\nimport { renderAnalogClock } from './AnalogClock.js';\nimport { renderCalendar } from './Calendar.js';\nimport { renderThermometer } from './Thermometer.js';\nimport { renderBalanceScale } from './BalanceScale.js';\nimport { renderMeasuringJug } from './MeasuringJug.js';\nimport { renderMoneyDisplay } from './MoneyDisplay.js';\nimport { renderPriceTagCompare } from './PriceTagCompare.js';\n\nexport const COMPONENT_REGISTRY = {\n  TenFrame: renderTenFrame\x2C\n  JarOfMarbles: renderJarOfMarbles\x2C\n  Spinner: renderSpinner\x2C\n  ItemCounter: renderItemCounter\x2C\n  Image: renderImage\x2C\n  VisualChoicePanel: drawVisualChoicePanel\x2C\n  SceneComposer: renderSceneComposer\x2C\n  PlaceValue: renderPlaceValue\x2C\n  BaseTenBlocks: renderPlaceValue\x2C\n\n  // New Phase 1 Maps\n  NumberLine: renderNumberLine\x2C\n  NumberLineInteractive: renderNumberLine\x2C // maps both to renderNumberLine\n  HundredChart: renderHundredChart\x2C\n  Rekenrek: renderRekenrek\x2C\n  NumberBond: renderNumberBond\x2C\n  TallyChart: renderTallyChart\x2C\n  FractionBar: renderFractionBar\x2C\n  FractionCircle: renderFractionCircle\x2C\n  FractionGrid: renderFractionGrid\x2C\n  DecimalGrid: renderDecimalGrid\x2C\n  DecimalLine: renderDecimalLine\x2C\n  ShapeCanvas: renderShapeCanvas\x2C\n  CoordinatePlane: renderCoordinatePlane\x2C\n  Protractor: renderProtractor\x2C\n  Ruler: renderRuler\x2C\n  Geoboard: renderGeoboard\x2C\n  BarGraph: renderBarGraph\x2C\n  Pictograph: renderPictograph\x2C\n  FrequencyTable: renderFrequencyTable\x2C\n  AnalogClock: renderAnalogClock\x2C\n  AnalogClockInteractive: renderAnalogClock\x2C // maps both to renderAnalogClock\n  Calendar: renderCalendar\x2C\n  Thermometer: renderThermometer\x2C\n  BalanceScale: renderBalanceScale\x2C\n  MeasuringJug: renderMeasuringJug\x2C\n  MoneyDisplay: renderMoneyDisplay\x2C\n  PriceTagCompare: renderPriceTagCompare\n};\n\n\n
