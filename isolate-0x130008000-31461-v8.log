script-source,506,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/expressionParser.js,import { COMPONENT_REGISTRY } from './components/index.js';\n\n// Safe math expression parser (CSP-safe)\nfunction evaluateSimpleExpression(str) {\n  let s = String(str).replace(/\\s+/g\x2C '');\n  \n  while (s.includes('(')) {\n    const prev = s;\n    s = s.replace(/\\(([^()]*)\\)/g\x2C (match\x2C subExpr) => {\n      return evaluateSimpleExpression(subExpr);\n    });\n    if (s === prev) {\n      s = s.replace(/\\(\\)/g\x2C '0');\n      if (s === prev) break;\n    }\n  }\n  \n  const tokens = [];\n  let numberBuffer = '';\n  \n  for (let i = 0; i < s.length; i++) {\n    const char = s[i];\n    if (/[0-9.]/.test(char)) {\n      numberBuffer += char;\n    } else if (char === '-' && (i === 0 || /[+\\-*/%]/.test(s[i - 1]))) {\n      numberBuffer += char;\n    } else {\n      if (numberBuffer) {\n        tokens.push(parseFloat(numberBuffer));\n        numberBuffer = '';\n      }\n      tokens.push(char);\n    }\n  }\n  if (numberBuffer) {\n    tokens.push(parseFloat(numberBuffer));\n  }\n  \n  // 1. Process multiplications\x2C divisions\x2C modulo\n  let i = 0;\n  while (i < tokens.length) {\n    if (tokens[i] === '*' || tokens[i] === '/' || tokens[i] === '%') {\n      const op = tokens[i];\n      const left = tokens[i - 1];\n      const right = tokens[i + 1];\n      let res = 0;\n      if (op === '*') res = left * right;\n      else if (op === '/') res = left / right;\n      else if (op === '%') res = left % right;\n      \n      tokens.splice(i - 1\x2C 3\x2C res);\n      i--;\n    } else {\n      i++;\n    }\n  }\n  \n  // 2. Process additions\x2C subtractions\n  i = 0;\n  while (i < tokens.length) {\n    if (tokens[i] === '+' || tokens[i] === '-') {\n      const op = tokens[i];\n      const left = tokens[i - 1];\n      const right = tokens[i + 1];\n      let res = 0;\n      if (op === '+') res = left + right;\n      else if (op === '-') res = left - right;\n      \n      tokens.splice(i - 1\x2C 3\x2C res);\n      i--;\n    } else {\n      i++;\n    }\n  }\n  \n  return tokens[0];\n}\n\nconst drawingHelpers = {\n  drawPlaceValue: (thousands\x2C hundreds\x2C tens\x2C ones\x2C showChart = true\x2C color = undefined) => {\n    return COMPONENT_REGISTRY.PlaceValue({ thousands\x2C hundreds\x2C tens\x2C ones\x2C showChart\x2C color });\n  }\x2C\n  drawBaseTenBlocks: (rodsCount\x2C blocksCount\x2C flatsCount = 0\x2C cubesCount = 0\x2C color = undefined) => {\n    return COMPONENT_REGISTRY.PlaceValue({ tens: rodsCount\x2C ones: blocksCount\x2C hundreds: flatsCount\x2C thousands: cubesCount\x2C showChart: false\x2C color });\n  }\x2C\n  drawTenFrame: (filledCount\x2C crossedOutCount = 0\x2C color = 'red') => {\n    return COMPONENT_REGISTRY.TenFrame({ filledCount\x2C crossedOutCount\x2C color });\n  }\x2C\n  drawJarOfMarbles: (colorA\x2C countA\x2C colorB\x2C countB\x2C seed) => {\n    return COMPONENT_REGISTRY.JarOfMarbles({ colorA\x2C countA\x2C colorB\x2C countB }\x2C seed);\n  }\x2C\n  drawSpinner: (colorA\x2C sectorsA\x2C colorB\x2C sectorsB) => {\n    return COMPONENT_REGISTRY.Spinner({ colorA\x2C sectorsA\x2C colorB\x2C sectorsB });\n  }\x2C\n  drawItemCounter: (itemCount\x2C itemType = 'cupcake'\x2C crossedOutCount = 0\x2C itemsPerRow = 5) => {\n    return COMPONENT_REGISTRY.ItemCounter({ count: itemCount\x2C itemType\x2C crossedOutCount\x2C itemsPerRow });\n  }\x2C\n  drawNumberLine: (min\x2C max\x2C step\x2C pointValue\x2C pointLabel = ''\x2C markedPoints = ''\x2C jumps = ''\x2C interactive = false\x2C color = 'blue') => {\n    return COMPONENT_REGISTRY.NumberLine({ min\x2C max\x2C step\x2C pointValue\x2C pointLabel\x2C markedPoints\x2C jumps\x2C interactive\x2C color });\n  }\x2C\n  drawHundredChart: (missing = ''\x2C highlighted = ''\x2C color = 'blue') => {\n    return COMPONENT_REGISTRY.HundredChart({ missing\x2C highlighted\x2C color });\n  }\x2C\n  drawRekenrek: (rows = 2\x2C values = '0\x2C0') => {\n    return COMPONENT_REGISTRY.Rekenrek({ rows\x2C values });\n  }\x2C\n  drawNumberBond: (whole\x2C left\x2C right\x2C missing = '') => {\n    return COMPONENT_REGISTRY.NumberBond({ whole\x2C left\x2C right\x2C missing });\n  }\x2C\n  drawTallyChart: (categories\x2C counts\x2C showFrequency = true) => {\n    return COMPONENT_REGISTRY.TallyChart({ categories\x2C counts\x2C showFrequency });\n  }\x2C\n  drawFractionBar: (denominator\x2C numerator\x2C color = 'blue'\x2C interactive = false) => {\n    return COMPONENT_REGISTRY.FractionBar({ denominator\x2C numerator\x2C color\x2C interactive });\n  }\x2C\n  drawFractionCircle: (denominator\x2C numerator\x2C color = 'red'\x2C interactive = false) => {\n    return COMPONENT_REGISTRY.FractionCircle({ denominator\x2C numerator\x2C color\x2C interactive });\n  }\x2C\n  drawFractionGrid: (rows\x2C cols\x2C shaded\x2C color = 'green'\x2C interactive = false) => {\n    return COMPONENT_REGISTRY.FractionGrid({ rows\x2C cols\x2C shaded\x2C color\x2C interactive });\n  }\x2C\n\n  drawDecimalGrid: (value\x2C color = 'orange') => {\n    return COMPONENT_REGISTRY.DecimalGrid({ value\x2C color });\n  }\x2C\n  drawDecimalLine: (min\x2C max\x2C step\x2C markedPoint\x2C pointLabel = ''\x2C color = 'blue') => {\n    return COMPONENT_REGISTRY.DecimalLine({ min\x2C max\x2C step\x2C markedPoint\x2C pointLabel\x2C color });\n  }\x2C\n  drawShapeCanvas: (shape\x2C label = ''\x2C color = 'purple') => {\n    return COMPONENT_REGISTRY.ShapeCanvas({ shape\x2C label\x2C color });\n  }\x2C\n  drawCoordinatePlane: (xMin\x2C xMax\x2C yMin\x2C yMax\x2C points = ''\x2C polygon = '') => {\n    return COMPONENT_REGISTRY.CoordinatePlane({ xMin\x2C xMax\x2C yMin\x2C yMax\x2C points\x2C polygon });\n  }\x2C\n  drawProtractor: (angle) => {\n    return COMPONENT_REGISTRY.Protractor({ angle });\n  }\x2C\n  drawRuler: (length\x2C objectLength\x2C objectType = 'pencil') => {\n    return COMPONENT_REGISTRY.Ruler({ length\x2C objectLength\x2C objectType });\n  }\x2C\n  drawGeoboard: (gridSize\x2C polygon = ''\x2C color = 'red') => {\n    return COMPONENT_REGISTRY.Geoboard({ gridSize\x2C polygon\x2C color });\n  }\x2C\n  drawBarGraph: (title\x2C categories\x2C values\x2C yMax = undefined\x2C color = 'blue') => {\n    return COMPONENT_REGISTRY.BarGraph({ title\x2C categories\x2C values\x2C yMax\x2C color });\n  }\x2C\n  drawPictograph: (categories\x2C values\x2C emoji = '\ud83c\udf4e'\x2C key = 1\x2C showCount = true) => {\n    return COMPONENT_REGISTRY.Pictograph({ categories\x2C values\x2C emoji\x2C key\x2C showCount });\n  }\x2C\n  drawFrequencyTable: (title\x2C categories\x2C values\x2C headers = 'Category\x2CFrequency') => {\n    return COMPONENT_REGISTRY.FrequencyTable({ title\x2C categories\x2C values\x2C headers });\n  }\x2C\n  drawAnalogClock: (hour\x2C minute\x2C interactive = false) => {\n    return COMPONENT_REGISTRY.AnalogClock({ hour\x2C minute\x2C interactive });\n  }\x2C\n  drawCalendar: (month\x2C daysInMonth\x2C startDay\x2C highlightDays = '') => {\n    return COMPONENT_REGISTRY.Calendar({ month\x2C daysInMonth\x2C startDay\x2C highlightDays });\n  }\x2C\n  drawThermometer: (min\x2C max\x2C value\x2C unit = 'C') => {\n    return COMPONENT_REGISTRY.Thermometer({ min\x2C max\x2C value\x2C unit });\n  }\x2C\n  drawBalanceScale: (leftWeight\x2C rightWeight\x2C leftLabel = 'Box A'\x2C rightLabel = 'Box B'\x2C showStacked = false) => {\n    return COMPONENT_REGISTRY.BalanceScale({ leftWeight\x2C rightWeight\x2C leftLabel\x2C rightLabel\x2C showStacked });\n  }\x2C\n  drawMeasuringJug: (capacity\x2C step\x2C value) => {\n    return COMPONENT_REGISTRY.MeasuringJug({ capacity\x2C step\x2C value });\n  }\x2C\n  drawMoneyDisplay: (amount) => {\n    return COMPONENT_REGISTRY.MoneyDisplay({ amount });\n  }\x2C\n  drawPriceTagCompare: (itemA\x2C priceA\x2C itemB\x2C priceB) => {\n    return COMPONENT_REGISTRY.PriceTagCompare({ itemA\x2C priceA\x2C itemB\x2C priceB });\n  }\n};\n\n\nexport function resolveExpression(expr\x2C context) {\n  if (typeof expr === 'number') return expr;\n  if (!expr) return 0;\n\n  // Interpolate list-like visual props (e.g. coordinates "h\x2Ck" or point lists) containing variables\n  if (typeof expr === 'string') {\n    let interpolated = expr.trim();\n    let hasReplacements = false;\n    const sortedKeys = Object.keys(context || {}).sort((a\x2C b) => b.length - a.length);\n\n    sortedKeys.forEach(key => {\n      const regex = new RegExp(`\\\\b${key}\\\\b`\x2C 'g');\n      if (regex.test(interpolated)) {\n        interpolated = interpolated.replace(regex\x2C context[key]);\n        hasReplacements = true;\n      }\n    });\n\n    if (hasReplacements) {\n      const num = Number(interpolated);\n      if (Number.isFinite(num)) {\n        return num;\n      }\n      const isJSExpr = /[=\\!<>\\?:]/.test(interpolated) || interpolated.includes("'") || interpolated.includes('"');\n      if (/[\x2C;]/.test(interpolated) && !interpolated.includes('draw') && !interpolated.startsWith('[') && !interpolated.startsWith('{') && !isJSExpr) {\n        return interpolated;\n      }\n    }\n  }\n\n  let cleanedExpr = String(expr);\n  if (cleanedExpr.includes('[') && cleanedExpr.includes(']')) {\n    cleanedExpr = cleanedExpr.replace(/(?<![A-Za-z0-9_\\]\\)])\\[([A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]+\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\]/g\x2C (_\x2C name) => {\n      const trimmed = name.trim();\n      if (context[trimmed] !== undefined) {\n        return context[trimmed];\n      }\n      try {\n        return new Function('ctx'\x2C `with(ctx) { return ${trimmed}; }`)(context);\n      } catch {\n        return `[${trimmed}]`;\n      }\n    });\n  }\n  expr = cleanedExpr;\n\n  const hasOperators = /[\\+\\-\\*\\/\\%\\(\\)]/.test(String(expr));\n  const hasComparisons = /[=\\!<>\\?:]/.test(String(expr));\n\n  // Try custom safe parser first if it is a simple math formula without conditionals/strings\n  if (hasOperators && !hasComparisons && !String(expr).includes('draw')) {\n    // Replace variables by their value from context\n    let evaluated = String(expr).replace(/[a-zA-Z_]+/g\x2C (token) => {\n      if (context[token] !== undefined) {\n        return context[token];\n      }\n      return token;\n    });\n\n    try {\n      const parsedVal = evaluateSimpleExpression(evaluated);\n      if (parsedVal !== undefined && !isNaN(parsedVal)) {\n        return parsedVal;\n      }\n    } catch (e) {\n      // Ignore and fallback\n    }\n  }\n\n  try {\n    const varNames = [...Object.keys(context || {})\x2C ...Object.keys(drawingHelpers)];\n    const varValues = [...Object.values(context || {})\x2C ...Object.values(drawingHelpers)];\n    // Evaluate in context scope to support strings and conditionals correctly\n    return new Function(...varNames\x2C `"use strict"; return (${expr})`)(...varValues);\n  } catch (err) {\n    // Fallback if compilation fails\n    try {\n      let evaluated = String(expr).replace(/[a-zA-Z_]+/g\x2C (token) => {\n        if (context[token] !== undefined) {\n          return context[token];\n        }\n        return token;\n      });\n      return Function(`"use strict"; return (${evaluated})`)();\n    } catch (e) {\n      return expr;\n    }\n  }\n}\n\nexport { evaluateSimpleExpression };\n
