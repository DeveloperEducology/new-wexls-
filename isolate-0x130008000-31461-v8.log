script-source,580,node:internal/dns/promises,'use strict';\nconst {\n  ArrayPrototypeMap\x2C\n  ObjectDefineProperty\x2C\n  Promise\x2C\n  ReflectApply\x2C\n  Symbol\x2C\n} = primordials;\n\nconst {\n  bindDefaultResolver\x2C\n  createResolverClass\x2C\n  validateHints\x2C\n  emitInvalidHostnameWarning\x2C\n  errorCodes: dnsErrorCodes\x2C\n  getDefaultResultOrder\x2C\n  setDefaultResultOrder\x2C\n  setDefaultResolver\x2C\n  validDnsOrders\x2C\n  validFamilies\x2C\n} = require('internal/dns/utils');\n\nconst {\n  NODATA\x2C\n  FORMERR\x2C\n  SERVFAIL\x2C\n  NOTFOUND\x2C\n  NOTIMP\x2C\n  REFUSED\x2C\n  BADQUERY\x2C\n  BADNAME\x2C\n  BADFAMILY\x2C\n  BADRESP\x2C\n  CONNREFUSED\x2C\n  TIMEOUT\x2C\n  EOF\x2C\n  FILE\x2C\n  NOMEM\x2C\n  DESTRUCTION\x2C\n  BADSTR\x2C\n  BADFLAGS\x2C\n  NONAME\x2C\n  BADHINTS\x2C\n  NOTINITIALIZED\x2C\n  LOADIPHLPAPI\x2C\n  ADDRGETNETWORKPARAMS\x2C\n  CANCELLED\x2C\n} = dnsErrorCodes;\nconst {\n  DNSException\x2C\n  codes: {\n    ERR_INVALID_ARG_TYPE\x2C\n    ERR_INVALID_ARG_VALUE\x2C\n    ERR_MISSING_ARGS\x2C\n  }\x2C\n} = require('internal/errors');\nconst { isIP } = require('internal/net');\nconst {\n  getaddrinfo\x2C\n  getnameinfo\x2C\n  GetAddrInfoReqWrap\x2C\n  GetNameInfoReqWrap\x2C\n  QueryReqWrap\x2C\n  DNS_ORDER_VERBATIM\x2C\n  DNS_ORDER_IPV4_FIRST\x2C\n  DNS_ORDER_IPV6_FIRST\x2C\n} = internalBinding('cares_wrap');\nconst {\n  validateBoolean\x2C\n  validateNumber\x2C\n  validateOneOf\x2C\n  validatePort\x2C\n  validateString\x2C\n} = require('internal/validators');\n\nconst kPerfHooksDnsLookupContext = Symbol('kPerfHooksDnsLookupContext');\nconst kPerfHooksDnsLookupServiceContext = Symbol('kPerfHooksDnsLookupServiceContext');\nconst kPerfHooksDnsLookupResolveContext = Symbol('kPerfHooksDnsLookupResolveContext');\n\nconst {\n  hasObserver\x2C\n  startPerf\x2C\n  stopPerf\x2C\n} = require('internal/perf/observe');\n\nfunction onlookup(err\x2C addresses) {\n  if (err) {\n    this.reject(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\n    return;\n  }\n\n  const family = this.family || isIP(addresses[0]);\n  this.resolve({ address: addresses[0]\x2C family });\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\n  }\n}\n\nfunction onlookupall(err\x2C addresses) {\n  if (err) {\n    this.reject(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\n    return;\n  }\n\n  const family = this.family;\n\n  for (let i = 0; i < addresses.length; i++) {\n    const address = addresses[i];\n\n    addresses[i] = {\n      address\x2C\n      family: family || isIP(addresses[i])\x2C\n    };\n  }\n\n  this.resolve(addresses);\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\n  }\n}\n\n/**\n * Creates a promise that resolves with the IP address of the given hostname.\n * @param {0 | 4 | 6} family - The IP address family (4 or 6\x2C or 0 for both).\n * @param {string} hostname - The hostname to resolve.\n * @param {boolean} all - Whether to resolve with all IP addresses for the hostname.\n * @param {number} hints - One or more supported getaddrinfo flags (supply multiple via\n *   bitwise OR).\n * @param {number} dnsOrder - How to sort results. Must be `ipv4first`\x2C `ipv6first` or `verbatim`.\n * @returns {Promise<DNSLookupResult | DNSLookupResult[]>} The IP address(es) of the hostname.\n * @typedef {object} DNSLookupResult\n * @property {string} address - The IP address.\n * @property {0 | 4 | 6} family - The IP address type. 4 for IPv4 or 6 for IPv6\x2C or 0 (for both).\n */\nfunction createLookupPromise(family\x2C hostname\x2C all\x2C hints\x2C dnsOrder) {\n  return new Promise((resolve\x2C reject) => {\n    if (!hostname) {\n      emitInvalidHostnameWarning(hostname);\n      resolve(all ? [] : { address: null\x2C family: family === 6 ? 6 : 4 });\n      return;\n    }\n\n    const matchedFamily = isIP(hostname);\n\n    if (matchedFamily !== 0) {\n      const result = { address: hostname\x2C family: matchedFamily };\n      resolve(all ? [result] : result);\n      return;\n    }\n\n    const req = new GetAddrInfoReqWrap();\n\n    req.family = family;\n    req.hostname = hostname;\n    req.oncomplete = all ? onlookupall : onlookup;\n    req.resolve = resolve;\n    req.reject = reject;\n\n    let order = DNS_ORDER_VERBATIM;\n\n    if (dnsOrder === 'ipv4first') {\n      order = DNS_ORDER_IPV4_FIRST;\n    } else if (dnsOrder === 'ipv6first') {\n      order = DNS_ORDER_IPV6_FIRST;\n    }\n\n    const err = getaddrinfo(req\x2C hostname\x2C family\x2C hints\x2C order);\n\n    if (err) {\n      reject(new DNSException(err\x2C 'getaddrinfo'\x2C hostname));\n    } else if (hasObserver('dns')) {\n      const detail = {\n        hostname\x2C\n        family\x2C\n        hints\x2C\n        verbatim: order === DNS_ORDER_VERBATIM\x2C\n        order: dnsOrder\x2C\n      };\n      startPerf(req\x2C kPerfHooksDnsLookupContext\x2C { type: 'dns'\x2C name: 'lookup'\x2C detail });\n    }\n  });\n}\n\n/**\n * Get the IP address for a given hostname.\n * @param {string} hostname - The hostname to resolve (ex. 'nodejs.org').\n * @param {object} [options] - Optional settings.\n * @param {boolean} [options.all] - Whether to return all or just the first resolved address.\n * @param {0 | 4 | 6} [options.family] - The record family. Must be 4\x2C 6\x2C or 0 (for both).\n * @param {number} [options.hints] - One or more supported getaddrinfo flags (supply multiple via\n *   bitwise OR).\n * @param {'ipv4first' | 'ipv6first' | 'verbatim'} [options.order] - Return results in same order DNS resolved them;\n *   New code should supply `verbatim`.\n * @returns {Promise<object>}\n */\nfunction lookup(hostname\x2C options) {\n  let hints = 0;\n  let family = 0;\n  let all = false;\n  let dnsOrder = getDefaultResultOrder();\n\n  // Parse arguments\n  if (hostname) {\n    validateString(hostname\x2C 'hostname');\n  }\n\n  if (typeof options === 'number') {\n    validateOneOf(options\x2C 'family'\x2C validFamilies);\n    family = options;\n  } else if (options !== undefined && typeof options !== 'object') {\n    throw new ERR_INVALID_ARG_TYPE('options'\x2C ['integer'\x2C 'object']\x2C options);\n  } else {\n    if (options?.hints != null) {\n      validateNumber(options.hints\x2C 'options.hints');\n      hints = options.hints >>> 0;\n      validateHints(hints);\n    }\n    if (options?.family != null) {\n      validateOneOf(options.family\x2C 'options.family'\x2C validFamilies);\n      family = options.family;\n    }\n    if (options?.all != null) {\n      validateBoolean(options.all\x2C 'options.all');\n      all = options.all;\n    }\n    if (options?.verbatim != null) {\n      validateBoolean(options.verbatim\x2C 'options.verbatim');\n      dnsOrder = options.verbatim ? 'verbatim' : 'ipv4first';\n    }\n    if (options?.order != null) {\n      validateOneOf(options.order\x2C 'options.order'\x2C validDnsOrders);\n      dnsOrder = options.order;\n    }\n  }\n\n  return createLookupPromise(family\x2C hostname\x2C all\x2C hints\x2C dnsOrder);\n}\n\n\nfunction onlookupservice(err\x2C hostname\x2C service) {\n  if (err) {\n    this.reject(new DNSException(err\x2C 'getnameinfo'\x2C this.host));\n    return;\n  }\n\n  this.resolve({ hostname\x2C service });\n  if (this[kPerfHooksDnsLookupServiceContext] && hasObserver('dns')) {\n    stopPerf(this\x2C kPerfHooksDnsLookupServiceContext\x2C { detail: { hostname\x2C service } });\n  }\n}\n\nfunction createLookupServicePromise(hostname\x2C port) {\n  return new Promise((resolve\x2C reject) => {\n    const req = new GetNameInfoReqWrap();\n\n    req.hostname = hostname;\n    req.port = port;\n    req.oncomplete = onlookupservice;\n    req.resolve = resolve;\n    req.reject = reject;\n\n    const err = getnameinfo(req\x2C hostname\x2C port);\n\n    if (err)\n      reject(new DNSException(err\x2C 'getnameinfo'\x2C hostname));\n    else if (hasObserver('dns')) {\n      startPerf(req\x2C kPerfHooksDnsLookupServiceContext\x2C {\n        type: 'dns'\x2C\n        name: 'lookupService'\x2C\n        detail: {\n          host: hostname\x2C\n          port\x2C\n        }\x2C\n      });\n    }\n  });\n}\n\nfunction lookupService(address\x2C port) {\n  if (arguments.length !== 2)\n    throw new ERR_MISSING_ARGS('address'\x2C 'port');\n\n  if (isIP(address) === 0)\n    throw new ERR_INVALID_ARG_VALUE('address'\x2C address);\n\n  validatePort(port);\n\n  return createLookupServicePromise(address\x2C +port);\n}\n\n\nfunction onresolve(err\x2C result\x2C ttls) {\n  if (err) {\n    this.reject(new DNSException(err\x2C this.bindingName\x2C this.hostname));\n    return;\n  }\n\n  if (ttls && this.ttl)\n    result = ArrayPrototypeMap(\n      result\x2C (address\x2C index) => ({ address\x2C ttl: ttls[index] }));\n\n  this.resolve(result);\n  if (this[kPerfHooksDnsLookupResolveContext] && hasObserver('dns')) {\n    stopPerf(this\x2C kPerfHooksDnsLookupResolveContext\x2C { detail: { result } });\n  }\n}\n\nfunction createResolverPromise(resolver\x2C bindingName\x2C hostname\x2C ttl) {\n  return new Promise((resolve\x2C reject) => {\n    const req = new QueryReqWrap();\n\n    req.bindingName = bindingName;\n    req.hostname = hostname;\n    req.oncomplete = onresolve;\n    req.resolve = resolve;\n    req.reject = reject;\n    req.ttl = ttl;\n\n    const err = resolver._handle[bindingName](req\x2C hostname);\n\n    if (err)\n      reject(new DNSException(err\x2C bindingName\x2C hostname));\n    else if (hasObserver('dns')) {\n      startPerf(req\x2C kPerfHooksDnsLookupResolveContext\x2C {\n        type: 'dns'\x2C\n        name: bindingName\x2C\n        detail: {\n          host: hostname\x2C\n          ttl\x2C\n        }\x2C\n      });\n    }\n  });\n}\n\nfunction resolver(bindingName) {\n  function query(name\x2C options) {\n    validateString(name\x2C 'name');\n\n    const ttl = !!(options?.ttl);\n    return createResolverPromise(this\x2C bindingName\x2C name\x2C ttl);\n  }\n\n  ObjectDefineProperty(query\x2C 'name'\x2C { __proto__: null\x2C value: bindingName });\n  return query;\n}\n\nfunction resolve(hostname\x2C rrtype) {\n  let resolver;\n\n  if (rrtype !== undefined) {\n    validateString(rrtype\x2C 'rrtype');\n\n    resolver = resolveMap[rrtype];\n\n    if (typeof resolver !== 'function')\n      throw new ERR_INVALID_ARG_VALUE('rrtype'\x2C rrtype);\n  } else {\n    resolver = resolveMap.A;\n  }\n\n  return ReflectApply(resolver\x2C this\x2C [hostname]);\n}\n\n// Promise-based resolver.\nconst { Resolver\x2C resolveMap } = createResolverClass(resolver);\nResolver.prototype.resolve = resolve;\n\nfunction defaultResolverSetServers(servers) {\n  const resolver = new Resolver();\n\n  resolver.setServers(servers);\n  setDefaultResolver(resolver);\n  bindDefaultResolver(module.exports\x2C Resolver.prototype);\n}\n\nmodule.exports = {\n  lookup\x2C\n  lookupService\x2C\n  Resolver\x2C\n  getDefaultResultOrder\x2C\n  setDefaultResultOrder\x2C\n  setServers: defaultResolverSetServers\x2C\n\n  // ERROR CODES\n  NODATA\x2C\n  FORMERR\x2C\n  SERVFAIL\x2C\n  NOTFOUND\x2C\n  NOTIMP\x2C\n  REFUSED\x2C\n  BADQUERY\x2C\n  BADNAME\x2C\n  BADFAMILY\x2C\n  BADRESP\x2C\n  CONNREFUSED\x2C\n  TIMEOUT\x2C\n  EOF\x2C\n  FILE\x2C\n  NOMEM\x2C\n  DESTRUCTION\x2C\n  BADSTR\x2C\n  BADFLAGS\x2C\n  NONAME\x2C\n  BADHINTS\x2C\n  NOTINITIALIZED\x2C\n  LOADIPHLPAPI\x2C\n  ADDRGETNETWORKPARAMS\x2C\n  CANCELLED\x2C\n};\nbindDefaultResolver(module.exports\x2C Resolver.prototype);\n
