script-source,402,/Users/vijay/Desktop/antigravity/new wexls/node_modules/punycode/punycode.js,'use strict';\n\n/** Highest positive signed 32-bit float value */\nconst maxInt = 2147483647; // aka. 0x7FFFFFFF or 2^31-1\n\n/** Bootstring parameters */\nconst base = 36;\nconst tMin = 1;\nconst tMax = 26;\nconst skew = 38;\nconst damp = 700;\nconst initialBias = 72;\nconst initialN = 128; // 0x80\nconst delimiter = '-'; // '\\x2D'\n\n/** Regular expressions */\nconst regexPunycode = /^xn--/;\nconst regexNonASCII = /[^\\0-\\x7F]/; // Note: U+007F DEL is excluded too.\nconst regexSeparators = /[\\x2E\\u3002\\uFF0E\\uFF61]/g; // RFC 3490 separators\n\n/** Error messages */\nconst errors = {\n\x09'overflow': 'Overflow: input needs wider integers to process'\x2C\n\x09'not-basic': 'Illegal input >= 0x80 (not a basic code point)'\x2C\n\x09'invalid-input': 'Invalid input'\n};\n\n/** Convenience shortcuts */\nconst baseMinusTMin = base - tMin;\nconst floor = Math.floor;\nconst stringFromCharCode = String.fromCharCode;\n\n/*--------------------------------------------------------------------------*/\n\n/**\n * A generic error utility function.\n * @private\n * @param {String} type The error type.\n * @returns {Error} Throws a `RangeError` with the applicable error message.\n */\nfunction error(type) {\n\x09throw new RangeError(errors[type]);\n}\n\n/**\n * A generic `Array#map` utility function.\n * @private\n * @param {Array} array The array to iterate over.\n * @param {Function} callback The function that gets called for every array\n * item.\n * @returns {Array} A new array of values returned by the callback function.\n */\nfunction map(array\x2C callback) {\n\x09const result = [];\n\x09let length = array.length;\n\x09while (length--) {\n\x09\x09result[length] = callback(array[length]);\n\x09}\n\x09return result;\n}\n\n/**\n * A simple `Array#map`-like wrapper to work with domain name strings or email\n * addresses.\n * @private\n * @param {String} domain The domain name or email address.\n * @param {Function} callback The function that gets called for every\n * character.\n * @returns {String} A new string of characters returned by the callback\n * function.\n */\nfunction mapDomain(domain\x2C callback) {\n\x09const parts = domain.split('@');\n\x09let result = '';\n\x09if (parts.length > 1) {\n\x09\x09// In email addresses\x2C only the domain name should be punycoded. Leave\n\x09\x09// the local part (i.e. everything up to `@`) intact.\n\x09\x09result = parts[0] + '@';\n\x09\x09domain = parts[1];\n\x09}\n\x09// Avoid `split(regex)` for IE8 compatibility. See #17.\n\x09domain = domain.replace(regexSeparators\x2C '\\x2E');\n\x09const labels = domain.split('.');\n\x09const encoded = map(labels\x2C callback).join('.');\n\x09return result + encoded;\n}\n\n/**\n * Creates an array containing the numeric code points of each Unicode\n * character in the string. While JavaScript uses UCS-2 internally\x2C\n * this function will convert a pair of surrogate halves (each of which\n * UCS-2 exposes as separate characters) into a single code point\x2C\n * matching UTF-16.\n * @see `punycode.ucs2.encode`\n * @see <https://mathiasbynens.be/notes/javascript-encoding>\n * @memberOf punycode.ucs2\n * @name decode\n * @param {String} string The Unicode input string (UCS-2).\n * @returns {Array} The new array of code points.\n */\nfunction ucs2decode(string) {\n\x09const output = [];\n\x09let counter = 0;\n\x09const length = string.length;\n\x09while (counter < length) {\n\x09\x09const value = string.charCodeAt(counter++);\n\x09\x09if (value >= 0xD800 && value <= 0xDBFF && counter < length) {\n\x09\x09\x09// It's a high surrogate\x2C and there is a next character.\n\x09\x09\x09const extra = string.charCodeAt(counter++);\n\x09\x09\x09if ((extra & 0xFC00) == 0xDC00) { // Low surrogate.\n\x09\x09\x09\x09output.push(((value & 0x3FF) << 10) + (extra & 0x3FF) + 0x10000);\n\x09\x09\x09} else {\n\x09\x09\x09\x09// It's an unmatched surrogate; only append this code unit\x2C in case the\n\x09\x09\x09\x09// next code unit is the high surrogate of a surrogate pair.\n\x09\x09\x09\x09output.push(value);\n\x09\x09\x09\x09counter--;\n\x09\x09\x09}\n\x09\x09} else {\n\x09\x09\x09output.push(value);\n\x09\x09}\n\x09}\n\x09return output;\n}\n\n/**\n * Creates a string based on an array of numeric code points.\n * @see `punycode.ucs2.decode`\n * @memberOf punycode.ucs2\n * @name encode\n * @param {Array} codePoints The array of numeric code points.\n * @returns {String} The new Unicode string (UCS-2).\n */\nconst ucs2encode = codePoints => String.fromCodePoint(...codePoints);\n\n/**\n * Converts a basic code point into a digit/integer.\n * @see `digitToBasic()`\n * @private\n * @param {Number} codePoint The basic numeric code point value.\n * @returns {Number} The numeric value of a basic code point (for use in\n * representing integers) in the range `0` to `base - 1`\x2C or `base` if\n * the code point does not represent a value.\n */\nconst basicToDigit = function(codePoint) {\n\x09if (codePoint >= 0x30 && codePoint < 0x3A) {\n\x09\x09return 26 + (codePoint - 0x30);\n\x09}\n\x09if (codePoint >= 0x41 && codePoint < 0x5B) {\n\x09\x09return codePoint - 0x41;\n\x09}\n\x09if (codePoint >= 0x61 && codePoint < 0x7B) {\n\x09\x09return codePoint - 0x61;\n\x09}\n\x09return base;\n};\n\n/**\n * Converts a digit/integer into a basic code point.\n * @see `basicToDigit()`\n * @private\n * @param {Number} digit The numeric value of a basic code point.\n * @returns {Number} The basic code point whose value (when used for\n * representing integers) is `digit`\x2C which needs to be in the range\n * `0` to `base - 1`. If `flag` is non-zero\x2C the uppercase form is\n * used; else\x2C the lowercase form is used. The behavior is undefined\n * if `flag` is non-zero and `digit` has no uppercase form.\n */\nconst digitToBasic = function(digit\x2C flag) {\n\x09//  0..25 map to ASCII a..z or A..Z\n\x09// 26..35 map to ASCII 0..9\n\x09return digit + 22 + 75 * (digit < 26) - ((flag != 0) << 5);\n};\n\n/**\n * Bias adaptation function as per section 3.4 of RFC 3492.\n * https://tools.ietf.org/html/rfc3492#section-3.4\n * @private\n */\nconst adapt = function(delta\x2C numPoints\x2C firstTime) {\n\x09let k = 0;\n\x09delta = firstTime ? floor(delta / damp) : delta >> 1;\n\x09delta += floor(delta / numPoints);\n\x09for (/* no initialization */; delta > baseMinusTMin * tMax >> 1; k += base) {\n\x09\x09delta = floor(delta / baseMinusTMin);\n\x09}\n\x09return floor(k + (baseMinusTMin + 1) * delta / (delta + skew));\n};\n\n/**\n * Converts a Punycode string of ASCII-only symbols to a string of Unicode\n * symbols.\n * @memberOf punycode\n * @param {String} input The Punycode string of ASCII-only symbols.\n * @returns {String} The resulting string of Unicode symbols.\n */\nconst decode = function(input) {\n\x09// Don't use UCS-2.\n\x09const output = [];\n\x09const inputLength = input.length;\n\x09let i = 0;\n\x09let n = initialN;\n\x09let bias = initialBias;\n\n\x09// Handle the basic code points: let `basic` be the number of input code\n\x09// points before the last delimiter\x2C or `0` if there is none\x2C then copy\n\x09// the first basic code points to the output.\n\n\x09let basic = input.lastIndexOf(delimiter);\n\x09if (basic < 0) {\n\x09\x09basic = 0;\n\x09}\n\n\x09for (let j = 0; j < basic; ++j) {\n\x09\x09// if it's not a basic code point\n\x09\x09if (input.charCodeAt(j) >= 0x80) {\n\x09\x09\x09error('not-basic');\n\x09\x09}\n\x09\x09output.push(input.charCodeAt(j));\n\x09}\n\n\x09// Main decoding loop: start just after the last delimiter if any basic code\n\x09// points were copied; start at the beginning otherwise.\n\n\x09for (let index = basic > 0 ? basic + 1 : 0; index < inputLength; /* no final expression */) {\n\n\x09\x09// `index` is the index of the next character to be consumed.\n\x09\x09// Decode a generalized variable-length integer into `delta`\x2C\n\x09\x09// which gets added to `i`. The overflow checking is easier\n\x09\x09// if we increase `i` as we go\x2C then subtract off its starting\n\x09\x09// value at the end to obtain `delta`.\n\x09\x09const oldi = i;\n\x09\x09for (let w = 1\x2C k = base; /* no condition */; k += base) {\n\n\x09\x09\x09if (index >= inputLength) {\n\x09\x09\x09\x09error('invalid-input');\n\x09\x09\x09}\n\n\x09\x09\x09const digit = basicToDigit(input.charCodeAt(index++));\n\n\x09\x09\x09if (digit >= base) {\n\x09\x09\x09\x09error('invalid-input');\n\x09\x09\x09}\n\x09\x09\x09if (digit > floor((maxInt - i) / w)) {\n\x09\x09\x09\x09error('overflow');\n\x09\x09\x09}\n\n\x09\x09\x09i += digit * w;\n\x09\x09\x09const t = k <= bias ? tMin : (k >= bias + tMax ? tMax : k - bias);\n\n\x09\x09\x09if (digit < t) {\n\x09\x09\x09\x09break;\n\x09\x09\x09}\n\n\x09\x09\x09const baseMinusT = base - t;\n\x09\x09\x09if (w > floor(maxInt / baseMinusT)) {\n\x09\x09\x09\x09error('overflow');\n\x09\x09\x09}\n\n\x09\x09\x09w *= baseMinusT;\n\n\x09\x09}\n\n\x09\x09const out = output.length + 1;\n\x09\x09bias = adapt(i - oldi\x2C out\x2C oldi == 0);\n\n\x09\x09// `i` was supposed to wrap around from `out` to `0`\x2C\n\x09\x09// incrementing `n` each time\x2C so we'll fix that now:\n\x09\x09if (floor(i / out) > maxInt - n) {\n\x09\x09\x09error('overflow');\n\x09\x09}\n\n\x09\x09n += floor(i / out);\n\x09\x09i %= out;\n\n\x09\x09// Insert `n` at position `i` of the output.\n\x09\x09output.splice(i++\x2C 0\x2C n);\n\n\x09}\n\n\x09return String.fromCodePoint(...output);\n};\n\n/**\n * Converts a string of Unicode symbols (e.g. a domain name label) to a\n * Punycode string of ASCII-only symbols.\n * @memberOf punycode\n * @param {String} input The string of Unicode symbols.\n * @returns {String} The resulting Punycode string of ASCII-only symbols.\n */\nconst encode = function(input) {\n\x09const output = [];\n\n\x09// Convert the input in UCS-2 to an array of Unicode code points.\n\x09input = ucs2decode(input);\n\n\x09// Cache the length.\n\x09const inputLength = input.length;\n\n\x09// Initialize the state.\n\x09let n = initialN;\n\x09let delta = 0;\n\x09let bias = initialBias;\n\n\x09// Handle the basic code points.\n\x09for (const currentValue of input) {\n\x09\x09if (currentValue < 0x80) {\n\x09\x09\x09output.push(stringFromCharCode(currentValue));\n\x09\x09}\n\x09}\n\n\x09const basicLength = output.length;\n\x09let handledCPCount = basicLength;\n\n\x09// `handledCPCount` is the number of code points that have been handled;\n\x09// `basicLength` is the number of basic code points.\n\n\x09// Finish the basic string with a delimiter unless it's empty.\n\x09if (basicLength) {\n\x09\x09output.push(delimiter);\n\x09}\n\n\x09// Main encoding loop:\n\x09while (handledCPCount < inputLength) {\n\n\x09\x09// All non-basic code points < n have been handled already. Find the next\n\x09\x09// larger one:\n\x09\x09let m = maxInt;\n\x09\x09for (const currentValue of input) {\n\x09\x09\x09if (currentValue >= n && currentValue < m) {\n\x09\x09\x09\x09m = currentValue;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09// Increase `delta` enough to advance the decoder's <n\x2Ci> state to <m\x2C0>\x2C\n\x09\x09// but guard against overflow.\n\x09\x09const handledCPCountPlusOne = handledCPCount + 1;\n\x09\x09if (m - n > floor((maxInt - delta) / handledCPCountPlusOne)) {\n\x09\x09\x09error('overflow');\n\x09\x09}\n\n\x09\x09delta += (m - n) * handledCPCountPlusOne;\n\x09\x09n = m;\n\n\x09\x09for (const currentValue of input) {\n\x09\x09\x09if (currentValue < n && ++delta > maxInt) {\n\x09\x09\x09\x09error('overflow');\n\x09\x09\x09}\n\x09\x09\x09if (currentValue === n) {\n\x09\x09\x09\x09// Represent delta as a generalized variable-length integer.\n\x09\x09\x09\x09let q = delta;\n\x09\x09\x09\x09for (let k = base; /* no condition */; k += base) {\n\x09\x09\x09\x09\x09const t = k <= bias ? tMin : (k >= bias + tMax ? tMax : k - bias);\n\x09\x09\x09\x09\x09if (q < t) {\n\x09\x09\x09\x09\x09\x09break;\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09const qMinusT = q - t;\n\x09\x09\x09\x09\x09const baseMinusT = base - t;\n\x09\x09\x09\x09\x09output.push(\n\x09\x09\x09\x09\x09\x09stringFromCharCode(digitToBasic(t + qMinusT % baseMinusT\x2C 0))\n\x09\x09\x09\x09\x09);\n\x09\x09\x09\x09\x09q = floor(qMinusT / baseMinusT);\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09output.push(stringFromCharCode(digitToBasic(q\x2C 0)));\n\x09\x09\x09\x09bias = adapt(delta\x2C handledCPCountPlusOne\x2C handledCPCount === basicLength);\n\x09\x09\x09\x09delta = 0;\n\x09\x09\x09\x09++handledCPCount;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09++delta;\n\x09\x09++n;\n\n\x09}\n\x09return output.join('');\n};\n\n/**\n * Converts a Punycode string representing a domain name or an email address\n * to Unicode. Only the Punycoded parts of the input will be converted\x2C i.e.\n * it doesn't matter if you call it on a string that has already been\n * converted to Unicode.\n * @memberOf punycode\n * @param {String} input The Punycoded domain name or email address to\n * convert to Unicode.\n * @returns {String} The Unicode representation of the given Punycode\n * string.\n */\nconst toUnicode = function(input) {\n\x09return mapDomain(input\x2C function(string) {\n\x09\x09return regexPunycode.test(string)\n\x09\x09\x09? decode(string.slice(4).toLowerCase())\n\x09\x09\x09: string;\n\x09});\n};\n\n/**\n * Converts a Unicode string representing a domain name or an email address to\n * Punycode. Only the non-ASCII parts of the domain name will be converted\x2C\n * i.e. it doesn't matter if you call it with a domain that's already in\n * ASCII.\n * @memberOf punycode\n * @param {String} input The domain name or email address to convert\x2C as a\n * Unicode string.\n * @returns {String} The Punycode representation of the given domain name or\n * email address.\n */\nconst toASCII = function(input) {\n\x09return mapDomain(input\x2C function(string) {\n\x09\x09return regexNonASCII.test(string)\n\x09\x09\x09? 'xn--' + encode(string)\n\x09\x09\x09: string;\n\x09});\n};\n\n/*----------------------