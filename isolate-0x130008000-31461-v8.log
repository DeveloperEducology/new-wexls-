script-source,441,node:internal/crypto/argon2,'use strict';\n\nconst {\n  FunctionPrototypeCall\x2C\n  MathPow\x2C\n  Uint8Array\x2C\n} = primordials;\n\nconst { Buffer } = require('buffer');\n\nconst {\n  Argon2Job\x2C\n  kCryptoJobAsync\x2C\n  kCryptoJobSync\x2C\n  kTypeArgon2d\x2C\n  kTypeArgon2i\x2C\n  kTypeArgon2id\x2C\n} = internalBinding('crypto');\n\nconst { getArrayBufferOrView } = require('internal/crypto/util');\nconst {\n  validateString\x2C\n  validateFunction\x2C\n  validateInteger\x2C\n  validateObject\x2C\n  validateOneOf\x2C\n  validateUint32\x2C\n} = require('internal/validators');\n\nconst {\n  codes: {\n    ERR_CRYPTO_ARGON2_NOT_SUPPORTED\x2C\n  }\x2C\n} = require('internal/errors');\n\n/**\n * @param {'argon2d' | 'argon2i' | 'argon2id'} algorithm\n * @param {object} parameters\n * @param {ArrayBufferLike} parameters.message\n * @param {ArrayBufferLike} parameters.nonce\n * @param {number} parameters.parallelism\n * @param {number} parameters.tagLength\n * @param {number} parameters.memory\n * @param {number} parameters.passes\n * @param {ArrayBufferLike} [parameters.secret]\n * @param {ArrayBufferLike} [parameters.associatedData]\n * @param {Function} callback\n */\nfunction argon2(algorithm\x2C parameters\x2C callback) {\n  parameters = check(algorithm\x2C parameters);\n\n  validateFunction(callback\x2C 'callback');\n\n  const job = new Argon2Job(\n    kCryptoJobAsync\x2C\n    parameters.message\x2C\n    parameters.nonce\x2C\n    parameters.parallelism\x2C\n    parameters.tagLength\x2C\n    parameters.memory\x2C\n    parameters.passes\x2C\n    parameters.secret\x2C\n    parameters.associatedData\x2C\n    parameters.type);\n\n  job.ondone = (error\x2C result) => {\n    if (error !== undefined)\n      return FunctionPrototypeCall(callback\x2C job\x2C error);\n    const buf = Buffer.from(result);\n    return FunctionPrototypeCall(callback\x2C job\x2C null\x2C buf);\n  };\n\n  job.run();\n}\n\n/**\n * @param {'argon2d' | 'argon2i' | 'argon2id'} algorithm\n * @param {object} parameters\n * @param {ArrayBufferLike} parameters.message\n * @param {ArrayBufferLike} parameters.nonce\n * @param {number} parameters.parallelism\n * @param {number} parameters.tagLength\n * @param {number} parameters.memory\n * @param {number} parameters.passes\n * @param {ArrayBufferLike} [parameters.secret]\n * @param {ArrayBufferLike} [parameters.associatedData]\n * @returns {Buffer}\n */\nfunction argon2Sync(algorithm\x2C parameters) {\n  parameters = check(algorithm\x2C parameters);\n\n  const job = new Argon2Job(\n    kCryptoJobSync\x2C\n    parameters.message\x2C\n    parameters.nonce\x2C\n    parameters.parallelism\x2C\n    parameters.tagLength\x2C\n    parameters.memory\x2C\n    parameters.passes\x2C\n    parameters.secret\x2C\n    parameters.associatedData\x2C\n    parameters.type);\n\n  const { 0: err\x2C 1: result } = job.run();\n\n  if (err !== undefined)\n    throw err;\n\n  return Buffer.from(result);\n}\n\n/**\n * @param {'argon2d' | 'argon2i' | 'argon2id'} algorithm\n * @param {object} parameters\n * @param {ArrayBufferLike} parameters.message\n * @param {ArrayBufferLike} parameters.nonce\n * @param {number} parameters.parallelism\n * @param {number} parameters.tagLength\n * @param {number} parameters.memory\n * @param {number} parameters.passes\n * @param {ArrayBufferLike} [parameters.secret]\n * @param {ArrayBufferLike} [parameters.associatedData]\n * @returns {object}\n */\nfunction check(algorithm\x2C parameters) {\n  if (Argon2Job === undefined)\n    throw new ERR_CRYPTO_ARGON2_NOT_SUPPORTED();\n\n  validateString(algorithm\x2C 'algorithm');\n  validateOneOf(algorithm\x2C 'algorithm'\x2C ['argon2d'\x2C 'argon2i'\x2C 'argon2id']);\n\n  let type;\n  switch (algorithm) {\n    case 'argon2d':\n      type = kTypeArgon2d;\n      break;\n    case 'argon2i':\n      type = kTypeArgon2i;\n      break;\n    case 'argon2id':\n      type = kTypeArgon2id;\n      break;\n    default:  // unreachable\n      throw new ERR_CRYPTO_ARGON2_NOT_SUPPORTED();\n  }\n\n  validateObject(parameters\x2C 'parameters');\n\n  const { parallelism\x2C tagLength\x2C memory\x2C passes } = parameters;\n  const MAX_POSITIVE_UINT_32 = MathPow(2\x2C 32) - 1;\n\n  const message = getArrayBufferOrView(parameters.message\x2C 'parameters.message');\n  validateInteger(message.byteLength\x2C 'parameters.message.byteLength'\x2C 0\x2C MAX_POSITIVE_UINT_32);\n\n  const nonce = getArrayBufferOrView(parameters.nonce\x2C 'parameters.nonce');\n  validateInteger(nonce.byteLength\x2C 'parameters.nonce.byteLength'\x2C 8\x2C MAX_POSITIVE_UINT_32);\n\n  validateInteger(parallelism\x2C 'parameters.parallelism'\x2C 1\x2C MathPow(2\x2C 24) - 1);\n  validateInteger(tagLength\x2C 'parameters.tagLength'\x2C 4\x2C MAX_POSITIVE_UINT_32);\n  validateInteger(memory\x2C 'parameters.memory'\x2C 8 * parallelism\x2C MAX_POSITIVE_UINT_32);\n  validateUint32(passes\x2C 'parameters.passes'\x2C true);\n\n  let secret;\n  if (parameters.secret === undefined) {\n    secret = new Uint8Array(0);\n  } else {\n    secret = getArrayBufferOrView(parameters.secret);\n    validateInteger(secret.byteLength\x2C 'parameters.secret.byteLength'\x2C 0\x2C MAX_POSITIVE_UINT_32);\n  }\n\n  let associatedData;\n  if (parameters.associatedData === undefined) {\n    associatedData = new Uint8Array(0);\n  } else {\n    associatedData = getArrayBufferOrView(parameters.associatedData);\n    validateInteger(associatedData.byteLength\x2C 'parameters.associatedData.byteLength'\x2C 0\x2C MAX_POSITIVE_UINT_32);\n  }\n\n  return { message\x2C nonce\x2C secret\x2C associatedData\x2C tagLength\x2C passes\x2C parallelism\x2C memory\x2C type };\n}\n\nmodule.exports = {\n  argon2\x2C\n  argon2Sync\x2C\n};\n
