code-creation,Script,9,303417,0x2595f6a73790,66, file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/MoneyDisplay.js:1:1,0x187db2260958,~
script-source,574,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/MoneyDisplay.js,import { SVG_DEFS } from './defs.js';\n\nfunction drawNote(x\x2C y\x2C value) {\n  let fill = '#ffffff';\n  let stroke = '#94a3b8';\n  let textCol = '#334155';\n\n  // Indian currency note colors\n  switch (value) {\n    case 100:\n      fill = '#e0e7ff'; // Lavender\n      stroke = '#4f46e5';\n      textCol = '#3730a3';\n      break;\n    case 50:\n      fill = '#e0f2fe'; // Cyan\n      stroke = '#0284c7';\n      textCol = '#075985';\n      break;\n    case 20:\n      fill = '#f0fdf4'; // Light Green\n      stroke = '#16a34a';\n      textCol = '#166534';\n      break;\n    case 10:\n      fill = '#fef3c7'; // Orange/Yellowish brown\n      stroke = '#d97706';\n      textCol = '#92400e';\n      break;\n  }\n\n  return `\n    <g transform="translate(${x}\x2C ${y})" filter="url(#shadow)">\n      <rect x="0" y="0" width="85" height="42" rx="4" fill="${fill}" stroke="${stroke}" stroke-width="2" />\n      <rect x="5" y="5" width="75" height="32" rx="2" fill="none" stroke="${stroke}" stroke-dasharray="2\x2C2" opacity="0.6" />\n      <!-- Mahatma Gandhi oval watermark placeholder -->\n      <circle cx="18" cy="21" r="10" fill="#ffffff" opacity="0.5" stroke="${stroke}" stroke-width="1" />\n      <!-- Rupee value text -->\n      <text x="62" y="26" font-family="system-ui\x2C sans-serif" font-size="14px" font-weight="900" fill="${textCol}" text-anchor="middle">\u20b9${value}</text>\n      <!-- Tiny value text in corners -->\n      <text x="78" y="12" font-family="system-ui\x2C sans-serif" font-size="6px" font-weight="900" fill="${textCol}" text-anchor="end">${value}</text>\n      <text x="78" y="36" font-family="system-ui\x2C sans-serif" font-size="6px" font-weight="900" fill="${textCol}" text-anchor="end">${value}</text>\n    </g>\n  `;\n}\n\nfunction drawCoin(x\x2C y\x2C value) {\n  let r = 16;\n  let outerFill = '#cbd5e1';\n  let innerFill = '#e2e8f0';\n  let stroke = '#64748b';\n  let textCol = '#334155';\n\n  switch (value) {\n    case 10:\n      // \u20b910 is bimetallic (gold outer\x2C silver inner)\n      outerFill = '#fbbf24';\n      innerFill = '#e2e8f0';\n      stroke = '#b45309';\n      textCol = '#451a03';\n      break;\n    case 5:\n      // \u20b95 is golden/brass\n      outerFill = '#f59e0b';\n      innerFill = '#fbbf24';\n      stroke = '#b45309';\n      textCol = '#78350f';\n      break;\n    case 2:\n      // \u20b92 is silver\n      outerFill = '#cbd5e1';\n      innerFill = '#f1f5f9';\n      stroke = '#475569';\n      textCol = '#1e293b';\n      break;\n    case 1:\n      // \u20b91 is smaller silver\n      r = 13;\n      outerFill = '#cbd5e1';\n      innerFill = '#f1f5f9';\n      stroke = '#475569';\n      textCol = '#1e293b';\n      break;\n  }\n\n  return `\n    <g transform="translate(${x}\x2C ${y})" filter="url(#shadow)">\n      <circle cx="0" cy="0" r="${r}" fill="${outerFill}" stroke="${stroke}" stroke-width="1.5" />\n      <circle cx="0" cy="0" r="${r - 3.5}" fill="${innerFill}" stroke="${stroke}" stroke-width="1" />\n      <text x="0" y="4" font-family="system-ui\x2C sans-serif" font-size="${r * 0.75}px" font-weight="900" fill="${textCol}" text-anchor="middle">\u20b9${value}</text>\n    </g>\n  `;\n}\n\nexport function renderMoneyDisplay(props) {\n  const amount = Math.max(0\x2C Number(props.amount) || 0);\n\n  // Divide into bills/coins\n  let remaining = amount;\n  const notesToShow = [];\n  const coinsToShow = [];\n\n  [100\x2C 50\x2C 20\x2C 10].forEach(denom => {\n    const count = Math.floor(remaining / denom);\n    for (let i = 0; i < count; i++) {\n      notesToShow.push(denom);\n    }\n    remaining %= denom;\n  });\n\n  [10\x2C 5\x2C 2\x2C 1].forEach(denom => {\n    const count = Math.floor(remaining / denom);\n    for (let i = 0; i < count; i++) {\n      coinsToShow.push(denom);\n    }\n    remaining %= denom;\n  });\n\n  const width = 450;\n  \n  // Arrange in rows\n  let markup = '';\n  let currentY = 15;\n  let currentX = 15;\n\n  // Render Notes\n  if (notesToShow.length > 0) {\n    notesToShow.forEach((val) => {\n      if (currentX + 90 > width - 15) {\n        currentX = 15;\n        currentY += 55;\n      }\n      markup += drawNote(currentX\x2C currentY\x2C val);\n      currentX += 95;\n    });\n    currentY += 60;\n  }\n\n  // Render Coins\n  if (coinsToShow.length > 0) {\n    currentX = 35; // margin offset for coins (cx centered)\n    coinsToShow.forEach((val) => {\n      const radius = val === 1 ? 13 : 16;\n      if (currentX + 25 > width - 15) {\n        currentX = 35;\n        currentY += 45;\n      }\n      markup += drawCoin(currentX\x2C currentY\x2C val);\n      currentX += 50;\n    });\n    currentY += 35;\n  }\n\n  const height = Math.max(80\x2C currentY + 15);\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: ${width}px; display: block; margin: 10px auto;">\n      ${SVG_DEFS}\n      <rect x="5" y="5" width="${width - 10}" height="${height - 10}" rx="12" fill="#ffffff" stroke="#e2e8f0" stroke-width="2.5" filter="url(#shadow)" />\n      <g>\n        ${markup}\n      </g>\n    </svg>\n  `.trim();\n}\n
