script-source,578,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/interpolator.js,import { resolveExpression } from './expressionParser.js';\n\n// String interpolator to replace [var_name] placeholders\nexport function interpolateString(str\x2C context) {\n  if (typeof str !== 'string') return str;\n\n  // Handle {{var}} mustache-style placeholders (used by template builder blueprint/solution)\n  str = str.replace(/\\{\\{([A-Za-z0-9_]+)\\}\\}/g\x2C (_\x2C name) => {\n    const trimmed = name.trim();\n    if (context[trimmed] !== undefined) return context[trimmed];\n    try { return resolveExpression(trimmed\x2C context); } catch (e) { return `{{${trimmed}}}`; }\n  });\n\n  // If the string is exactly a single placeholder\x2C return the resolved value directly to preserve types (objects\x2C arrays)\n  const exactMatch = str.trim().match(/^\\[([A-Za-z0-9_]+)\\]$/);\n  if (exactMatch) {\n    const varName = exactMatch[1];\n    if (context[varName] !== undefined) {\n      return context[varName];\n    }\n    try {\n      return resolveExpression(varName\x2C context);\n    } catch (e) {\n      // fallback\n    }\n  }\n\n  const blankTokens = [];\n  const protectedStr = str.replace(/\\[\\[[^\\]]+\\]\\]/g\x2C (token) => {\n    const key = `__INLINE_BLANK_${blankTokens.length}__`;\n    blankTokens.push(token);\n    return key;\n  });\n\n  const restoreBlankTokens = (value) => String(value).replace(/__INLINE_BLANK_(\\d+)__/g\x2C (_\x2C index) => blankTokens[Number(index)] || '');\n\n  const withPathTokens = protectedStr.replace(/\\[([A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]+\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\]/g\x2C (_\x2C name) => {\n    const trimmed = name.trim();\n    if (context[trimmed] !== undefined) {\n      return context[trimmed];\n    }\n    return resolveExpression(trimmed\x2C context);\n  });\n\n  const resolved = withPathTokens.replace(/\\[(.*?)\\]/g\x2C (_\x2C name) => {\n    const trimmed = name.trim();\n    if (context[trimmed] !== undefined) {\n      return context[trimmed];\n    }\n    // Try resolving as an expression directly if it's like [A - B]\n    return resolveExpression(trimmed\x2C context);\n  });\n\n  return restoreBlankTokens(resolved);\n}\n\n\n// Resolve labels that might be expressions or variables with/without brackets\nexport function resolveLabelOrExpression(label\x2C context) {\n  if (typeof label !== 'string') return label;\n  \n  let interpolated = label;\n  if ((label.includes('[') && label.includes(']')) || (label.includes('{{') && label.includes('}}'))) {\n    interpolated = interpolateString(label\x2C context);\n  }\n\n  if (typeof interpolated !== 'string') return interpolated;\n\n  // Parse fraction-like strings so they don't evaluate to decimal floats\n  // e.g. "4/7" or "4/(7 * 2)" -> "4/7" or "4/14"\n  if (interpolated.includes('/')) {\n    const parts = interpolated.split('/');\n    if (parts.length === 2) {\n      const numPart = parts[0].trim();\n      const denPart = parts[1].trim();\n      const mathTermRegex = /^[A-Za-z0-9_()+\\-*%\\s]+$/;\n      if (mathTermRegex.test(numPart) && mathTermRegex.test(denPart)) {\n        try {\n          const numVal = resolveExpression(numPart\x2C context);\n          const denVal = resolveExpression(denPart\x2C context);\n          if (typeof numVal === 'number' && typeof denVal === 'number' && !isNaN(numVal) && !isNaN(denVal)) {\n            return `${numVal}/${denVal}`;\n          }\n        } catch (e) {\n          // ignore and fallback\n        }\n      }\n    }\n  }\n\n  // If the string looks like a function call expression (contains parentheses)\x2C\n  // try evaluating it directly via resolveExpression.\n  // e.g. toWords(A) + ' minus ' + toWords(B) \u2192 "nine minus five"\n  if (interpolated.includes('(') && interpolated.includes(')')) {\n    try {\n      const result = resolveExpression(interpolated\x2C context);\n      if (result !== undefined && result !== interpolated && result !== null) {\n        return result;\n      }\n    } catch (e) {\n      // fall through to regex-based evaluation below\n    }\n  }\n  \n  const variableNames = Object.keys(context || {});\n  const escapedVars = variableNames.map(v => v.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g\x2C '\\\\$&'));\n  const varPattern = escapedVars.length > 0 ? '|' + escapedVars.join('|') : '';\n  const exprRegex = new RegExp(`^\\\\s*(\\\\d+|\\\\+|\\\\-|\\\\*|\\\\/|\\\\%|\\\\(|\\\\)|\\\\s${varPattern})+\\\\s*$`);\n  \n  if (exprRegex.test(interpolated)) {\n    if (/^\\s*\\d+(\\.\\d+)?\\s*$/.test(interpolated)) {\n      return parseFloat(interpolated);\n    }\n    const resolved = resolveExpression(interpolated\x2C context);\n    if (resolved !== undefined && resolved !== interpolated) {\n      return resolved;\n    }\n  }\n  \n  return interpolated;\n}\n\n\nexport function getCleanNameFromUrl(url) {\n  if (!url || typeof url !== 'string') return 'item';\n  try {\n    let filename = url.substring(url.lastIndexOf('/') + 1)\n      .split(/[?#]/)[0]\n      .replace(/\\.[^/.]+$/\x2C "");\n    \n    // Strip leading timestamp/id prefix like "1234567890-" or "1234567890_"\n    filename = filename.replace(/^\\d+[-_]/\x2C '');\n    \n    filename = filename.replace(/[-_]/g\x2C ' ').trim();\n    return filename || 'item';\n  } catch (e) {\n    return 'item';\n  }\n}\n\nexport function parseLabeledEntry(entry) {\n  if (!entry || typeof entry !== 'string') return { label: null\x2C url: entry };\n  const sepIdx = entry.indexOf('::');\n  if (sepIdx !== -1) {\n    const label = entry.slice(0\x2C sepIdx).trim();\n    const url = entry.slice(sepIdx + 2).trim();\n    return { label: label || null\x2C url };\n  }\n  return { label: null\x2C url: entry.trim() };\n}\n
