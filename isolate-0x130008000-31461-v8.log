script-source,526,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/PlaceValue.js,import { SVG_DEFS } from './defs.js';\n\nconst THEMES = {\n  green: {\n    top: '#bbf7d0'\x2C\n    left: '#4ade80'\x2C\n    right: '#22c55e'\x2C\n    stroke: '#15803d'\n  }\x2C\n  blue: {\n    top: '#bfdbfe'\x2C\n    left: '#60a5fa'\x2C\n    right: '#3b82f6'\x2C\n    stroke: '#1d4ed8'\n  }\x2C\n  orange: {\n    top: '#ffedd5'\x2C\n    left: '#fb923c'\x2C\n    right: '#f97316'\x2C\n    stroke: '#c2410c'\n  }\x2C\n  purple: {\n    top: '#e9d5ff'\x2C\n    left: '#c084fc'\x2C\n    right: '#a855f7'\x2C\n    stroke: '#7e22ce'\n  }\x2C\n  pink: {\n    top: '#fecdd3'\x2C\n    left: '#fb7185'\x2C\n    right: '#f43f5e'\x2C\n    stroke: '#be123c'\n  }\x2C\n  red: {\n    top: '#fee2e2'\x2C\n    left: '#f87171'\x2C\n    right: '#ef4444'\x2C\n    stroke: '#b91c1c'\n  }\x2C\n  yellow: {\n    top: '#fef08a'\x2C\n    left: '#facc15'\x2C\n    right: '#eab308'\x2C\n    stroke: '#a16207'\n  }\n};\n\nconst DEFAULT_THEMES = {\n  thousands: THEMES.green\x2C\n  hundreds: THEMES.green\x2C\n  tens: THEMES.green\x2C\n  ones: THEMES.green\n};\n\nfunction getTheme(type\x2C props) {\n  if (props.color && THEMES[props.color]) {\n    return THEMES[props.color];\n  }\n  const specColor = props[type + 'Color'];\n  if (specColor && THEMES[specColor]) {\n    return THEMES[specColor];\n  }\n  return DEFAULT_THEMES[type];\n}\n\nfunction drawCube(x\x2C y\x2C theme) {\n  const { top\x2C left\x2C right\x2C stroke } = theme;\n  return `\n    <g transform="translate(${x}\x2C ${y})">\n      <!-- Front Face -->\n      <rect x="0" y="5" width="18" height="18" fill="${left}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Right Face -->\n      <polygon points="18\x2C5 27\x2C0 27\x2C18 18\x2C23" fill="${right}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Top Face -->\n      <polygon points="9\x2C0 27\x2C0 18\x2C5 0\x2C5" fill="${top}" stroke="${stroke}" stroke-width="0.75" />\n    </g>\n  `;\n}\n\nfunction drawThousand(x\x2C y\x2C theme) {\n  const { top\x2C left\x2C right\x2C stroke } = theme;\n  let lines = '';\n  \n  // Top face grid lines\n  for (let j = 1; j < 10; j++) {\n    const xStart = j * 18;\n    const yStart = 5;\n    const xEnd = 90 + j * 18;\n    const yEnd = 0;\n    lines += `<line x1="${xStart}" y1="${yStart}" x2="${xEnd}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  for (let j = 1; j < 10; j++) {\n    const xStart = j * 9;\n    const yStart = 5 - j * 0.5;\n    const xEnd = 180 + j * 9;\n    const yEnd = 5 - j * 0.5;\n    lines += `<line x1="${xStart}" y1="${yStart}" x2="${xEnd}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  \n  // Front face grid lines\n  for (let j = 1; j < 10; j++) {\n    const xVal = j * 18;\n    lines += `<line x1="${xVal}" y1="5" x2="${xVal}" y2="185" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  for (let j = 1; j < 10; j++) {\n    const yVal = 5 + j * 18;\n    lines += `<line x1="0" y1="${yVal}" x2="180" y2="${yVal}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  \n  // Right face grid lines\n  for (let j = 1; j < 10; j++) {\n    const xVal = 180 + j * 9;\n    const yStart = 5 - j * 0.5;\n    const yEnd = 185 - j * 0.5;\n    lines += `<line x1="${xVal}" y1="${yStart}" x2="${xVal}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  for (let j = 1; j < 10; j++) {\n    const yValFront = 5 + j * 18;\n    const yValBack = j * 18;\n    lines += `<line x1="180" y1="${yValFront}" x2="270" y2="${yValBack}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n\n  return `\n    <g transform="translate(${x}\x2C ${y})">\n      <!-- Front Face -->\n      <rect x="0" y="5" width="180" height="180" fill="${left}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Right Face -->\n      <polygon points="180\x2C5 270\x2C0 270\x2C180 180\x2C185" fill="${right}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Top Face -->\n      <polygon points="90\x2C0 270\x2C0 180\x2C5 0\x2C5" fill="${top}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Grid lines -->\n      ${lines}\n    </g>\n  `;\n}\n\nfunction drawHundred(x\x2C y\x2C theme) {\n  const { top\x2C left\x2C right\x2C stroke } = theme;\n  let lines = '';\n  \n  // Top face grid lines\n  for (let j = 1; j < 10; j++) {\n    const xStart = j * 18;\n    const yStart = 5;\n    const xEnd = 90 + j * 18;\n    const yEnd = 0;\n    lines += `<line x1="${xStart}" y1="${yStart}" x2="${xEnd}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  for (let j = 1; j < 10; j++) {\n    const xStart = j * 9;\n    const yStart = 5 - j * 0.5;\n    const xEnd = 180 + j * 9;\n    const yEnd = 5 - j * 0.5;\n    lines += `<line x1="${xStart}" y1="${yStart}" x2="${xEnd}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  \n  // Front face vertical separators\n  for (let j = 1; j < 10; j++) {\n    const xVal = j * 18;\n    lines += `<line x1="${xVal}" y1="5" x2="${xVal}" y2="23" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  \n  // Right face vertical separators\n  for (let j = 1; j < 10; j++) {\n    const xVal = 180 + j * 9;\n    const yStart = 5 - j * 0.5;\n    const yEnd = 23 - j * 0.5;\n    lines += `<line x1="${xVal}" y1="${yStart}" x2="${xVal}" y2="${yEnd}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n\n  return `\n    <g transform="translate(${x}\x2C ${y})">\n      <!-- Front Face -->\n      <rect x="0" y="5" width="180" height="18" fill="${left}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Right Face -->\n      <polygon points="180\x2C5 270\x2C0 270\x2C18 180\x2C23" fill="${right}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Top Face -->\n      <polygon points="90\x2C0 270\x2C0 180\x2C5 0\x2C5" fill="${top}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Grid lines -->\n      ${lines}\n    </g>\n  `;\n}\n\nfunction drawTen(x\x2C y\x2C theme) {\n  const { top\x2C left\x2C right\x2C stroke } = theme;\n  let lines = '';\n  \n  // Separator lines for front face\n  for (let j = 1; j < 10; j++) {\n    const yVal = 5 + j * 18;\n    lines += `<line x1="0" y1="${yVal}" x2="18" y2="${yVal}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n  // Separator lines for right face\n  for (let j = 1; j < 10; j++) {\n    const yValFront = 5 + j * 18;\n    const yValBack = j * 18;\n    lines += `<line x1="18" y1="${yValFront}" x2="27" y2="${yValBack}" stroke="${stroke}" stroke-width="0.75" />`;\n  }\n\n  return `\n    <g transform="translate(${x}\x2C ${y})">\n      <!-- Front Face -->\n      <rect x="0" y="5" width="18" height="180" fill="${left}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Right Face -->\n      <polygon points="18\x2C5 27\x2C0 27\x2C180 18\x2C185" fill="${right}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Top Face -->\n      <polygon points="9\x2C0 27\x2C0 18\x2C5 0\x2C5" fill="${top}" stroke="${stroke}" stroke-width="0.75" />\n      <!-- Grid lines -->\n      ${lines}\n    </g>\n  `;\n}\n\nexport function renderPlaceValue(props) {\n  const thousands = Math.max(0\x2C Number(props.thousands || props.cubesCount) || 0);\n  const hundreds = Math.max(0\x2C Number(props.hundreds || props.flatsCount) || 0);\n  const tens = Math.max(0\x2C Number(props.tens || props.rodsCount) || 0);\n  const ones = Math.max(0\x2C Number(props.ones || props.blocksCount) || 0);\n  const showChart = props.showChart !== undefined ? (props.showChart === 'true' || props.showChart === true) : false;\n\n  const thousandsTheme = getTheme('thousands'\x2C props);\n  const hundredsTheme = getTheme('hundreds'\x2C props);\n  const tensTheme = getTheme('tens'\x2C props);\n  const onesTheme = getTheme('ones'\x2C props);\n\n  const hasThousands = thousands > 0;\n  const hasHundreds = hundreds > 0 || hasThousands;\n\n  let blocksMarkup = '';\n\n  if (showChart) {\n    // \u2500\u2500\u2500 Chart-Based Grid Layout \u2500\u2500\u2500\n    let columns = [];\n    if (hasThousands) {\n      columns.push({ type: 'thousands'\x2C label: 'Thousands (1000s)'\x2C width: 300 });\n    }\n    if (hasHundreds) {\n      columns.push({ type: 'hundreds'\x2C label: 'Hundreds (100s)'\x2C width: 300 });\n    }\n    columns.push({ type: 'tens'\x2C label: 'Tens (10s)'\x2C width: 300 });\n    columns.push({ type: 'ones'\x2C label: 'Ones (1s)'\x2C width: 150 });\n\n    let totalWidth = columns.reduce((sum\x2C col) => sum + col.width\x2C 0);\n    let canvasWidth = totalWidth + 40;\n    let canvasHeight = 280;\n\n    let headerHeight = 35;\n    let chartY = 10;\n    let columnsMarkup = '';\n    let currentX = 20;\n\n    columns.forEach((col) => {\n      const colX = currentX;\n      const colWidth = col.width;\n      const centerX = colX + colWidth / 2;\n\n      columnsMarkup += `\n        <!-- Column background header -->\n        <rect x="${colX}" y="${chartY}" width="${colWidth}" height="${headerHeight}" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1.5" rx="4" />\n        <!-- Column boundary lines -->\n        <rect x="${colX}" y="${chartY}" width="${colWidth}" height="${canvasHeight - chartY - 10}" fill="none" stroke="#cbd5e1" stroke-width="1.5" rx="6" />\n        <!-- Text label -->\n        <text x="${centerX}" y="${chartY + 22}" font-family="system-ui\x2C sans-serif" font-size="12px" font-weight="700" fill="#475569" text-anchor="middle">\n          ${col.label}\n        </text>\n      `;\n\n      if (col.type === 'thousands' && thousands > 0) {\n        // Draw thousands overlapping slightly horizontally\n        const step = 35;\n        const totalWidth = (thousands - 1) * step + 270;\n        const startX = centerX - totalWidth / 2;\n        for (let i = 0; i < thousands; i++) {\n          const x = startX + i * step;\n          const y = 80 - i * 5;\n          blocksMarkup += drawThousand(x\x2C y\x2C thousandsTheme);\n        }\n      } else if (col.type === 'hundreds' && hundreds > 0) {\n        // Stack hundreds flats vertically like pancakes\n        for (let i = 0; i < hundreds; i++) {\n          const x = centerX - 135;\n          const y = 242 - i * 15;\n          blocksMarkup += drawHundred(x\x2C y\x2C hundredsTheme);\n        }\n      } else if (col.type === 'tens' && tens > 0) {\n        // Draw tens rods with a clean gap and center them dynamically\n        const step = 32; // 5px gap between 27px wide rods\n        const totalWidth = (tens - 1) * step + 27;\n        const startX = centerX - totalWidth / 2;\n        for (let i = 0; i < tens; i++) {\n          const x = startX + i * step;\n          const y = 80;\n          blocksMarkup += drawTen(x\x2C y\x2C tensTheme);\n        }\n      } else if (col.type === 'ones' && ones > 0) {\n        for (let i = 0; i < ones; i++) {\n          const row = Math.floor(i / 2);\n          const cIdx = i % 2;\n          const x = centerX - 30 + cIdx * 32;\n          const y = 240 - row * 24;\n          blocksMarkup += drawCube(x\x2C y\x2C onesTheme);\n        }\n      }\n\n      currentX += colWidth;\n    });\n\n    return `\n      <svg viewBox="0 0 ${canvasWidth} ${canvasHeight}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: ${Math.min(canvasWidth\x2C 750)}px; display: block; margin: 15px auto;" filter="url(#shadow)">\n        ${SVG_DEFS}\n        ${columnsMarkup}\n        <g>${blocksMarkup}</g>\n      </svg>\n    `.trim();\n\n  } else {\n    // \u2500\u2500\u2500 IXL-Style Vertical Floating Layout with Medium Scaling (0.55x) \u2500\u2500\u2500\n    const scale = 0.55;\n\n    // 1. Calculate row dimensions and vertical positions (standard coordinates)\n    const thousandsRows = Math.ceil(thousands / 5);\n    const thousandsHeight = thousands > 0 ? (thousandsRows - 1) * 200 + 185 : 0;\n    \n    const hundredsHeight = hundreds > 0 ? (hundreds - 1) * 30 + 23 : 0;\n    \n    const tensAndOnesHeight = (tens > 0 || ones > 0) ? 185 : 0;\n\n    let rawHeight = 0;\n    let thousandsY = 0;\n    let hundredsY = 0;\n    let tensAndOnesY = 0;\n\n    if (thousands > 0) {\n      thousandsY = rawHeight;\n      rawHeight += thousandsHeight + 40;\n    }\n    if (hundreds > 0) {\n      hundredsY = rawHeight;\n      rawHeight += hundredsHeight + 40;\n    }\n    if (tens > 0 || ones > 0) {\n      tensAndOnesY = rawHeight;\n      rawHeight += tensAndOnesHeight + 20;\n    }\n\n    // 2. Calculate dynamic canvas width (standard coordinates)\n    const maxThousandsCols = Math.min(thousands\x2C 5);\n    const thousandsWidth = thousands > 0 ? (maxThousandsCols - 1) * 290 + 270 : 0;\n    const hundredsWidth = hundreds > 0 ? 270 : 0;\n    const tensWidth = tens > 0 ? (tens - 1) * 40 + 27 : 0;\n    \n    const onesCols = Math.min(ones\x2C 5);\n    const onesWidth = ones > 0 ? (onesCols - 1) * 40 + 27 : 0;\n    \n    const tensAndOnesWidth = tensWidth + (tensWidth > 0 && onesWidth > 0 ? 50 : 0) + onesWidth;\n    \n    const rawWidth = Math.max(thousandsWidth\x2C hundredsWidth\x2C tensAndOnesWidth\x2C 300);\n\n    // Scaled canvas dimensions with 20px padding on all sides\n    const canvasWidth = rawWidth * scale + 40;\n    const canvasHeight = rawHeight * scale + 40;\n\n    // 3. Render blocks at their calculated positions\n    let blocksMarkup = '';\n\n    // Render Thousands (Row 1)\n    if (thousands > 0) {\n      const startX = (rawWidth - thousandsWidth) / 2;\n      for (let i = 0; i < thousands; i++) {\n        const row = Math.floor(i / 5);\n        const col = i % 5;\n        const x = startX + col * 290;\n        const y = thousandsY + row * 200;\n        blocksMarkup += drawThousand(x\x2C y\x2C thousandsTheme);\n      }\n    }\n\n    // Render Hundreds (Row 2)\n    if (hundreds > 0) {\n      const startX = (rawWidth - 270) / 2;\n      for (let i = 0; i < hundreds; i++) {\n        const x = startX;\n        // Stack bottom flat first (i = 0 is bottom\x2C i = hundreds-1 is top)\n        const y = hundredsY + (hundreds - 1 - i) * 30;\n        blocksMarkup += drawHundred(x\x2C y\x2C hundredsTheme);\n      }\n    }\n\n    // Render Tens & Ones (Row 3)\n    if (tens > 0 || ones > 0) {\n      const startX = (rawWidth - tensAndOnesWidth) / 2;\n      \n      // Draw Tens rods\n      if (tens > 0) {\n        for (let i = 0; i < tens; i++) {\n          const x = startX + i * 40;\n          const y = tensAndOnesY;\n          blocksMarkup += drawTen(x\x2C y\x2C tensTheme);\n        }\n      }\n\n      // Draw Ones cubes (aligned to baseline of tens)\n      if (ones > 0) {\n        const onesStartX = startX + (tens > 0 ? (tens - 1) * 40 + 27 + 50 : 0);\n        for (let i = 0; i < ones; i++) {\n          const row = Math.floor(i / 5);\n          const col = i % 5;\n          const x = onesStartX + col * 40;\n          const y = tensAndOnesY + 162 - row * 30;\n          blocksMarkup += drawCube(x\x2C y\x2C onesTheme);\n        }\n      }\n    }\n\n    return `\n      <svg viewBox="0 0 ${canvasWidth} ${canvasHeight}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: ${Math.min(canvasWidth\x2C 750)}px; display: block; margin: 10px auto;" filter="url(#shadow)">\n        ${SVG_DEFS}\n        <g transform="translate(20\x2C 20) scale(${scale})">${blocksMarkup}</g>\n      </svg>\n    `.trim();\n  }\n}\n
