script-source,591,node:internal/crypto/webidl,'use strict';\n\n// Adapted from the following sources\n// - https://github.com/jsdom/webidl-conversions\n//   Copyright Domenic Denicola. Licensed under BSD-2-Clause License.\n//   Original license at https://github.com/jsdom/webidl-conversions/blob/master/LICENSE.md.\n// - https://github.com/denoland/deno\n//   Copyright Deno authors. Licensed under MIT License.\n//   Original license at https://github.com/denoland/deno/blob/main/LICENSE.md.\n// Changes include using primordials and stripping the code down to only what\n// WebCryptoAPI needs.\n\nconst {\n  ArrayBufferIsView\x2C\n  ArrayPrototypeIncludes\x2C\n  ArrayPrototypePush\x2C\n  ArrayPrototypeSort\x2C\n  MathPow\x2C\n  MathTrunc\x2C\n  Number\x2C\n  NumberIsFinite\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectPrototypeIsPrototypeOf\x2C\n  SafeArrayIterator\x2C\n  String\x2C\n  StringPrototypeStartsWith\x2C\n  StringPrototypeToLowerCase\x2C\n  TypedArrayPrototypeGetBuffer\x2C\n  TypedArrayPrototypeGetSymbolToStringTag\x2C\n} = primordials;\n\nconst {\n  makeException\x2C\n  createEnumConverter\x2C\n  createSequenceConverter\x2C\n} = require('internal/webidl');\n\nconst {\n  lazyDOMException\x2C\n  kEmptyObject\x2C\n  setOwnProperty\x2C\n} = require('internal/util');\nconst { CryptoKey } = require('internal/crypto/webcrypto');\nconst {\n  getDataViewOrTypedArrayBuffer\x2C\n  validateMaxBufferLength\x2C\n  kNamedCurveAliases\x2C\n} = require('internal/crypto/util');\nconst { isArrayBuffer\x2C isSharedArrayBuffer } = require('internal/util/types');\n\n// https://tc39.es/ecma262/#sec-tonumber\nfunction toNumber(value\x2C opts = kEmptyObject) {\n  switch (typeof value) {\n    case 'number':\n      return value;\n    case 'bigint':\n      throw makeException(\n        'is a BigInt and cannot be converted to a number.'\x2C\n        opts);\n    case 'symbol':\n      throw makeException(\n        'is a Symbol and cannot be converted to a number.'\x2C\n        opts);\n    default:\n      return Number(value);\n  }\n}\n\nfunction type(V) {\n  if (V === null)\n    return 'Null';\n\n  switch (typeof V) {\n    case 'undefined':\n      return 'Undefined';\n    case 'boolean':\n      return 'Boolean';\n    case 'number':\n      return 'Number';\n    case 'string':\n      return 'String';\n    case 'symbol':\n      return 'Symbol';\n    case 'bigint':\n      return 'BigInt';\n    case 'object': // Fall through\n    case 'function': // Fall through\n    default:\n      // Per ES spec\x2C typeof returns an implementation-defined value that is not\n      // any of the existing ones for uncallable non-standard exotic objects.\n      // Yet Type() which the Web IDL spec depends on returns Object for such\n      // cases. So treat the default case as an object.\n      return 'Object';\n  }\n}\n\nconst integerPart = MathTrunc;\n\nfunction validateByteLength(buf\x2C name\x2C target) {\n  if (buf.byteLength !== target) {\n    throw lazyDOMException(\n      `${name} must contain exactly ${target} bytes`\x2C\n      'OperationError');\n  }\n}\n\nfunction AESLengthValidator(V\x2C dict) {\n  if (V !== 128 && V !== 192 && V !== 256)\n    throw lazyDOMException(\n      'AES key length must be 128\x2C 192\x2C or 256 bits'\x2C\n      'OperationError');\n}\n\nfunction namedCurveValidator(V\x2C dict) {\n  if (!ObjectPrototypeHasOwnProperty(kNamedCurveAliases\x2C V))\n    throw lazyDOMException(\n      'Unrecognized namedCurve'\x2C\n      'NotSupportedError');\n}\n\n// This was updated to only consider bitlength up to 32 used by WebCryptoAPI\nfunction createIntegerConversion(bitLength) {\n  const lowerBound = 0;\n  const upperBound = MathPow(2\x2C bitLength) - 1;\n\n  const twoToTheBitLength = MathPow(2\x2C bitLength);\n\n  return (V\x2C opts = kEmptyObject) => {\n    let x = toNumber(V\x2C opts);\n\n    if (opts.enforceRange) {\n      if (!NumberIsFinite(x)) {\n        throw makeException(\n          'is not a finite number.'\x2C\n          opts);\n      }\n\n      x = integerPart(x);\n\n      if (x < lowerBound || x > upperBound) {\n        throw makeException(\n          `is outside the expected range of ${lowerBound} to ${upperBound}.`\x2C\n          { __proto__: null\x2C ...opts\x2C code: 'ERR_OUT_OF_RANGE' }\x2C\n        );\n      }\n\n      return x;\n    }\n\n    if (!NumberIsFinite(x) || x === 0) {\n      return 0;\n    }\n\n    x = integerPart(x);\n\n    if (x >= lowerBound && x <= upperBound) {\n      return x;\n    }\n\n    x = x % twoToTheBitLength;\n\n    return x;\n  };\n}\n\nconst converters = {};\n\nconverters.boolean = (val) => !!val;\nconverters.octet = createIntegerConversion(8);\nconverters['unsigned short'] = createIntegerConversion(16);\nconverters['unsigned long'] = createIntegerConversion(32);\n\nconverters.DOMString = function(V\x2C opts = kEmptyObject) {\n  if (typeof V === 'string') {\n    return V;\n  } else if (typeof V === 'symbol') {\n    throw makeException(\n      'is a Symbol and cannot be converted to a string.'\x2C\n      opts);\n  }\n\n  return String(V);\n};\n\nconverters.object = (V\x2C opts) => {\n  if (type(V) !== 'Object') {\n    throw makeException(\n      'is not an object.'\x2C\n      opts);\n  }\n\n  return V;\n};\n\nconst isNonSharedArrayBuffer = isArrayBuffer;\n\nfunction ensureSHA(V\x2C label) {\n  if (\n    typeof V === 'string' ?\n      !StringPrototypeStartsWith(StringPrototypeToLowerCase(V)\x2C 'sha') :\n      V.name?.toLowerCase?.().startsWith('sha') === false\n  )\n    throw lazyDOMException(\n      `Only SHA hashes are supported in ${label}`\x2C 'NotSupportedError');\n}\n\nconverters.Uint8Array = (V\x2C opts = kEmptyObject) => {\n  if (!ArrayBufferIsView(V) ||\n    TypedArrayPrototypeGetSymbolToStringTag(V) !== 'Uint8Array') {\n    throw makeException(\n      'is not an Uint8Array object.'\x2C\n      opts);\n  }\n  if (isSharedArrayBuffer(TypedArrayPrototypeGetBuffer(V))) {\n    throw makeException(\n      'is a view on a SharedArrayBuffer\x2C which is not allowed.'\x2C\n      opts);\n  }\n\n  return V;\n};\n\nconverters.BufferSource = (V\x2C opts = kEmptyObject) => {\n  if (ArrayBufferIsView(V)) {\n    if (isSharedArrayBuffer(getDataViewOrTypedArrayBuffer(V))) {\n      throw makeException(\n        'is a view on a SharedArrayBuffer\x2C which is not allowed.'\x2C\n        opts);\n    }\n\n    return V;\n  }\n\n  if (!isNonSharedArrayBuffer(V)) {\n    throw makeException(\n      'is not instance of ArrayBuffer\x2C Buffer\x2C TypedArray\x2C or DataView.'\x2C\n      opts);\n  }\n\n  return V;\n};\n\nconverters['sequence<DOMString>'] = createSequenceConverter(\n  converters.DOMString);\n\nfunction requiredArguments(length\x2C required\x2C opts = kEmptyObject) {\n  if (length < required) {\n    throw makeException(\n      `${required} argument${\n        required === 1 ? '' : 's'\n      } required\x2C but only ${length} present.`\x2C\n      { __proto__: null\x2C ...opts\x2C context: ''\x2C code: 'ERR_MISSING_ARGS' });\n  }\n}\n\nfunction createDictionaryConverter(name\x2C dictionaries) {\n  let hasRequiredKey = false;\n  const allMembers = [];\n  for (let i = 0; i < dictionaries.length; i++) {\n    const member = dictionaries[i];\n    if (member.required) {\n      hasRequiredKey = true;\n    }\n    ArrayPrototypePush(allMembers\x2C member);\n  }\n  ArrayPrototypeSort(allMembers\x2C (a\x2C b) => {\n    if (a.key === b.key) {\n      return 0;\n    }\n    return a.key < b.key ? -1 : 1;\n  });\n\n  return function(V\x2C opts = kEmptyObject) {\n    const typeV = type(V);\n    switch (typeV) {\n      case 'Undefined':\n      case 'Null':\n      case 'Object':\n        break;\n      default:\n        throw makeException(\n          'can not be converted to a dictionary'\x2C\n          opts);\n    }\n    const esDict = V;\n    const idlDict = {};\n\n    // Fast path null and undefined.\n    if (V == null && !hasRequiredKey) {\n      return idlDict;\n    }\n\n    for (const member of new SafeArrayIterator(allMembers)) {\n      const key = member.key;\n\n      let esMemberValue;\n      if (typeV === 'Undefined' || typeV === 'Null') {\n        esMemberValue = undefined;\n      } else {\n        esMemberValue = esDict[key];\n      }\n\n      if (esMemberValue !== undefined) {\n        const context = `'${key}' of '${name}'${\n          opts.context ? ` (${opts.context})` : ''\n        }`;\n        const { converter\x2C validator } = member;\n        const idlMemberValue = converter(esMemberValue\x2C {\n          __proto__: null\x2C\n          ...opts\x2C\n          context\x2C\n        });\n        validator?.(idlMemberValue\x2C esDict);\n        setOwnProperty(idlDict\x2C key\x2C idlMemberValue);\n      } else if (member.required) {\n        throw makeException(\n          `can not be converted to '${name}' because '${key}' is required in '${name}'.`\x2C\n          { __proto__: null\x2C ...opts\x2C code: 'ERR_MISSING_OPTION' });\n      }\n    }\n\n    return idlDict;\n  };\n}\n\nfunction createInterfaceConverter(name\x2C prototype) {\n  return (V\x2C opts) => {\n    if (!ObjectPrototypeIsPrototypeOf(prototype\x2C V)) {\n      throw makeException(\n        `is not of type ${name}.`\x2C\n        opts);\n    }\n    return V;\n  };\n}\n\nconverters.AlgorithmIdentifier = (V\x2C opts) => {\n  // Union for (object or DOMString)\n  if (type(V) === 'Object') {\n    return converters.object(V\x2C opts);\n  }\n  return converters.DOMString(V\x2C opts);\n};\n\nconverters.KeyFormat = createEnumConverter('KeyFormat'\x2C [\n  'raw'\x2C\n  'raw-public'\x2C\n  'raw-seed'\x2C\n  'raw-secret'\x2C\n  'raw-private'\x2C\n  'pkcs8'\x2C\n  'spki'\x2C\n  'jwk'\x2C\n]);\n\nconverters.KeyUsage = createEnumConverter('KeyUsage'\x2C [\n  'encrypt'\x2C\n  'decrypt'\x2C\n  'sign'\x2C\n  'verify'\x2C\n  'deriveKey'\x2C\n  'deriveBits'\x2C\n  'wrapKey'\x2C\n  'unwrapKey'\x2C\n  'encapsulateBits'\x2C\n  'decapsulateBits'\x2C\n  'encapsulateKey'\x2C\n  'decapsulateKey'\x2C\n]);\n\nconverters['sequence<KeyUsage>'] = createSequenceConverter(converters.KeyUsage);\n\nconverters.HashAlgorithmIdentifier = converters.AlgorithmIdentifier;\n\nconst dictAlgorithm = [\n  {\n    key: 'name'\x2C\n    converter: converters.DOMString\x2C\n    required: true\x2C\n  }\x2C\n];\n\nconverters.Algorithm = createDictionaryConverter(\n  'Algorithm'\x2C dictAlgorithm);\n\nconverters.BigInteger = converters.Uint8Array;\n\nconst dictRsaKeyGenParams = [\n  ...new SafeArrayIterator(dictAlgorithm)\x2C\n  {\n    key: 'modulusLength'\x2C\n    converter: (V\x2C opts) =>\n      converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n    required: true\x2C\n  }\x2C\n  {\n    key: 'publicExponent'\x2C\n    converter: converters.BigInteger\x2C\n    required: true\x2C\n  }\x2C\n];\n\nconverters.RsaKeyGenParams = createDictionaryConverter(\n  'RsaKeyGenParams'\x2C dictRsaKeyGenParams);\n\nconverters.RsaHashedKeyGenParams = createDictionaryConverter(\n  'RsaHashedKeyGenParams'\x2C [\n    ...new SafeArrayIterator(dictRsaKeyGenParams)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'RsaHashedKeyGenParams')\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.RsaHashedImportParams = createDictionaryConverter(\n  'RsaHashedImportParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'RsaHashedImportParams')\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.NamedCurve = converters.DOMString;\n\nconverters.EcKeyImportParams = createDictionaryConverter(\n  'EcKeyImportParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'namedCurve'\x2C\n      converter: converters.NamedCurve\x2C\n      validator: namedCurveValidator\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.EcKeyGenParams = createDictionaryConverter(\n  'EcKeyGenParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'namedCurve'\x2C\n      converter: converters.NamedCurve\x2C\n      validator: namedCurveValidator\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.AesKeyGenParams = createDictionaryConverter(\n  'AesKeyGenParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned short'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: AESLengthValidator\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.HmacKeyGenParams = createDictionaryConverter(\n  'HmacKeyGenParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'HmacKeyGenParams')\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C dict) => validateHmacKeyAlgorithm(V)\x2C\n    }\x2C\n  ]);\n\nfunction validateHmacKeyAlgorithm(length) {\n  if (length === 0)\n    throw lazyDOMException('Zero-length key is not supported'\x2C 'DataError');\n\n  // The Web Crypto spec allows for key lengths that are not multiples of 8. We don't.\n  if (length % 8)\n    throw lazyDOMException('Unsupported algorithm.length'\x2C 'NotSupportedError');\n}\n\nfunction validateZeroLength(parameterName) {\n  return (V\x2C dict) => {\n    if (V.byteLength) {\n      throw lazyDOMException(\n        `Non zero-length ${parameterName} is not supported.`\x2C 'NotSupportedError');\n    }\n  };\n}\n\nconverters.RsaPssParams = createDictionaryConverter(\n  'RsaPssParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'saltLength'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.RsaOaepParams = createDictionaryConverter(\n  'RsaOaepParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'label'\x2C\n      converter: converters.BufferSource\x2C\n    }\x2C\n  ]);\n\nconverters.EcdsaParams = createDictionaryConverter(\n  'EcdsaParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'EcdsaParams')\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.HmacImportParams = createDictionaryConverter(\n  'HmacImportParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'HmacImportParams')\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C dict) => validateHmacKeyAlgorithm(V)\x2C\n    }\x2C\n  ]);\n\nconst simpleDomStringKey = (key) => ({ key\x2C converter: converters.DOMString });\n\nconverters.RsaOtherPrimesInfo = createDictionaryConverter(\n  'RsaOtherPrimesInfo'\x2C [\n    simpleDomStringKey('r')\x2C\n    simpleDomStringKey('d')\x2C\n    simpleDomStringKey('t')\x2C\n  ]);\nconverters['sequence<RsaOtherPrimesInfo>'] = createSequenceConverter(\n  converters.RsaOtherPrimesInfo);\n\nconverters.JsonWebKey = createDictionaryConverter(\n  'JsonWebKey'\x2C [\n    simpleDomStringKey('kty')\x2C\n    simpleDomStringKey('use')\x2C\n    {\n      key: 'key_ops'\x2C\n      converter: converters['sequence<DOMString>']\x2C\n    }\x2C\n    simpleDomStringKey('alg')\x2C\n    {\n      key: 'ext'\x2C\n      converter: converters.boolean\x2C\n    }\x2C\n    simpleDomStringKey('crv')\x2C\n    simpleDomStringKey('x')\x2C\n    simpleDomStringKey('y')\x2C\n    simpleDomStringKey('d')\x2C\n    simpleDomStringKey('n')\x2C\n    simpleDomStringKey('e')\x2C\n    simpleDomStringKey('p')\x2C\n    simpleDomStringKey('q')\x2C\n    simpleDomStringKey('dp')\x2C\n    simpleDomStringKey('dq')\x2C\n    simpleDomStringKey('qi')\x2C\n    simpleDomStringKey('pub')\x2C\n    simpleDomStringKey('priv')\x2C\n    {\n      key: 'oth'\x2C\n      converter: converters['sequence<RsaOtherPrimesInfo>']\x2C\n    }\x2C\n    simpleDomStringKey('k')\x2C\n  ]);\n\nconverters.HkdfParams = createDictionaryConverter(\n  'HkdfParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'HkdfParams')\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'salt'\x2C\n      converter: converters.BufferSource\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'info'\x2C\n      converter: converters.BufferSource\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.CShakeParams = createDictionaryConverter(\n  'CShakeParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C opts) => {\n        // The Web Crypto spec allows for SHAKE output length that are not multiples of\n        // 8. We don't.\n        if (V % 8)\n          throw lazyDOMException('Unsupported CShakeParams length'\x2C 'NotSupportedError');\n      }\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'functionName'\x2C\n      converter: converters.BufferSource\x2C\n      validator: validateZeroLength('CShakeParams.functionName')\x2C\n    }\x2C\n    {\n      key: 'customization'\x2C\n      converter: converters.BufferSource\x2C\n      validator: validateZeroLength('CShakeParams.customization')\x2C\n    }\x2C\n  ]);\n\nconverters.Pbkdf2Params = createDictionaryConverter(\n  'Pbkdf2Params'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'hash'\x2C\n      converter: converters.HashAlgorithmIdentifier\x2C\n      validator: (V\x2C dict) => ensureSHA(V\x2C 'Pbkdf2Params')\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'iterations'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C dict) => {\n        if (V === 0)\n          throw lazyDOMException('iterations cannot be zero'\x2C 'OperationError');\n      }\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'salt'\x2C\n      converter: converters.BufferSource\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.AesDerivedKeyParams = createDictionaryConverter(\n  'AesDerivedKeyParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters['unsigned short'](V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: AESLengthValidator\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.AesCbcParams = createDictionaryConverter(\n  'AesCbcParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'iv'\x2C\n      converter: converters.BufferSource\x2C\n      validator: (V\x2C dict) => validateByteLength(V\x2C 'algorithm.iv'\x2C 16)\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.AeadParams = createDictionaryConverter(\n  'AeadParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'iv'\x2C\n      converter: converters.BufferSource\x2C\n      validator: (V\x2C dict) => {\n        switch (StringPrototypeToLowerCase(dict.name)) {\n          case 'chacha20-poly1305':\n            validateByteLength(V\x2C 'algorithm.iv'\x2C 12);\n            break;\n          case 'aes-gcm':\n            validateMaxBufferLength(V\x2C 'algorithm.iv');\n            break;\n          case 'aes-ocb':\n            if (V.byteLength > 15) {\n              throw lazyDOMException(\n                'AES-OCB algorithm.iv must be no more than 15 bytes'\x2C\n                'OperationError');\n            }\n            break;\n        }\n      }\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'tagLength'\x2C\n      converter: (V\x2C opts) =>\n        converters.octet(V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C dict) => {\n        switch (StringPrototypeToLowerCase(dict.name)) {\n          case 'chacha20-poly1305':\n            if (V !== 128) {\n              throw lazyDOMException(\n                `${V} is not a valid ChaCha20-Poly1305 tag length`\x2C\n                'OperationError');\n            }\n            break;\n          case 'aes-gcm':\n            if (!ArrayPrototypeIncludes([32\x2C 64\x2C 96\x2C 104\x2C 112\x2C 120\x2C 128]\x2C V)) {\n              throw lazyDOMException(\n                `${V} is not a valid AES-GCM tag length`\x2C\n                'OperationError');\n            }\n            break;\n          case 'aes-ocb':\n            if (!ArrayPrototypeIncludes([64\x2C 96\x2C 128]\x2C V)) {\n              throw lazyDOMException(\n                `${V} is not a valid AES-OCB tag length`\x2C\n                'OperationError');\n            }\n            break;\n        }\n      }\x2C\n    }\x2C\n    {\n      key: 'additionalData'\x2C\n      converter: converters.BufferSource\x2C\n      validator: (V\x2C dict) => validateMaxBufferLength(V\x2C 'algorithm.additionalData')\x2C\n    }\x2C\n  ]);\n\nconverters.AesCtrParams = createDictionaryConverter(\n  'AesCtrParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'counter'\x2C\n      converter: converters.BufferSource\x2C\n      validator: (V\x2C dict) => validateByteLength(V\x2C 'algorithm.counter'\x2C 16)\x2C\n      required: true\x2C\n    }\x2C\n    {\n      key: 'length'\x2C\n      converter: (V\x2C opts) =>\n        converters.octet(V\x2C { ...opts\x2C enforceRange: true })\x2C\n      validator: (V\x2C dict) => {\n        if (V === 0 || V > 128)\n          throw lazyDOMException(\n            'AES-CTR algorithm.length must be between 1 and 128'\x2C\n            'OperationError');\n      }\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nconverters.CryptoKey = createInterfaceConverter(\n  'CryptoKey'\x2C CryptoKey.prototype);\n\nconverters.EcdhKeyDeriveParams = createDictionaryConverter(\n  'EcdhKeyDeriveParams'\x2C [\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\n    {\n      key: 'public'\x2C\n      converter: converters.CryptoKey\x2C\n      validator: (V\x2C dict) => {\n        if (V.type !== 'public')\n          throw lazyDOMException(\n            'algorithm.public must be a public key'\x2C 'InvalidAccessError');\n\n        if (StringPrototypeToLowerCase(V.algorithm.name) !== StringPrototypeToLowerCase(dict.name))\n          throw lazyDOMException(\n            'key algorithm mismatch'\x2C\n            'InvalidAccessError');\n      }\x2C\n      required: true\x2C\n    }\x2C\n  ]);\n\nfor (const name of ['Ed448Params'\x2C 'ContextParams']) {\n  converters[name] = createDictionaryConverter(\n    name\x2C [\n      ...new SafeArrayIterator(dictAlgorithm)\x2C\n      {\n        key: 'context'\x2C\n        converter: converters.BufferSource\x2C\n        validator: validateZeroLength(`${name}.context`)\x2C\n      }\x2C\n    ]);\n}\n\nmodule.exports = {\n  converters\x2C\n  requiredArguments\x2C\n};\n
