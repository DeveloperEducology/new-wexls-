script-source,548,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/ShapeCanvas.js,import { COLORS\x2C SVG_DEFS\x2C resolveColor } from './defs.js';\n\nexport function renderShapeCanvas(props\x2C rng) {\n  const shape = String(props.shape || 'triangle').toLowerCase();\n  const label = props.label || '';\n  const color = props.color || 'purple';\n\n  const theme = resolveColor(color\x2C COLORS\x2C rng);\n\n  const width = 200;\n  const height = 200;\n  const cx = width / 2;\n  const cy = height / 2;\n\n  let shapeMarkup = '';\n\n  switch (shape) {\n    case 'circle':\n      shapeMarkup = `\n        <circle cx="${cx}" cy="${cy - 10}" r="65" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" filter="url(#shadow)" />\n      `;\n      break;\n    case 'square':\n      shapeMarkup = `\n        <rect x="${cx - 60}" y="${cy - 70}" width="120" height="120" rx="8" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" filter="url(#shadow)" />\n      `;\n      break;\n    case 'rectangle':\n      shapeMarkup = `\n        <rect x="${cx - 75}" y="${cy - 50}" width="150" height="90" rx="8" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" filter="url(#shadow)" />\n      `;\n      break;\n    case 'triangle':\n      shapeMarkup = `\n        <polygon points="${cx}\x2C${cy - 70} ${cx - 75}\x2C${cy + 55} ${cx + 75}\x2C${cy + 55}" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" stroke-linejoin="round" filter="url(#shadow)" />\n      `;\n      break;\n    case 'pentagon':\n      shapeMarkup = `\n        <polygon points="\n          ${cx}\x2C${cy - 70} \n          ${cx - 70}\x2C${cy - 20} \n          ${cx - 45}\x2C${cy + 55} \n          ${cx + 45}\x2C${cy + 55} \n          ${cx + 70}\x2C${cy - 20}\n        " fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" stroke-linejoin="round" filter="url(#shadow)" />\n      `;\n      break;\n    case 'hexagon':\n      shapeMarkup = `\n        <polygon points="\n          ${cx}\x2C${cy - 72} \n          ${cx - 65}\x2C${cy - 36} \n          ${cx - 65}\x2C${cy + 36} \n          ${cx}\x2C${cy + 72} \n          ${cx + 65}\x2C${cy + 36} \n          ${cx + 65}\x2C${cy - 36}\n        " fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" stroke-linejoin="round" filter="url(#shadow)" />\n      `;\n      break;\n    case 'trapezoid':\n      shapeMarkup = `\n        <polygon points="\n          ${cx - 45}\x2C${cy - 50} \n          ${cx + 45}\x2C${cy - 50} \n          ${cx + 80}\x2C${cy + 50} \n          ${cx - 80}\x2C${cy + 50}\n        " fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3.5" stroke-linejoin="round" filter="url(#shadow)" />\n      `;\n      break;\n    default:\n      // Fallback rectangle\n      shapeMarkup = `\n        <rect x="${cx - 60}" y="${cy - 60}" width="120" height="120" fill="${theme.fill}" stroke="${theme.stroke}" stroke-width="3" filter="url(#shadow)" />\n      `;\n  }\n\n  const labelMarkup = label ? `\n    <text x="${cx}" y="${height - 12}" font-family="system-ui\x2C sans-serif" font-size="14px" font-weight="900" fill="#334155" text-anchor="middle">\n      ${label}\n    </text>\n  ` : '';\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: 200px; display: block; margin: 10px auto;">\n      ${SVG_DEFS}\n      <g>\n        ${shapeMarkup}\n        ${labelMarkup}\n      </g>\n    </svg>\n  `.trim();\n}\n
