script-source,534,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/NumberBond.js,import { SVG_DEFS } from './defs.js';\n\nexport function renderNumberBond(props) {\n  const wholeVal = props.whole !== undefined ? String(props.whole) : '';\n  const leftVal = props.left !== undefined ? String(props.left) : '';\n  const rightVal = props.right !== undefined ? String(props.right) : '';\n  const missing = props.missing || ''; // 'whole'\x2C 'left'\x2C 'right'\n\n  const width = 360;\n  const height = 240;\n\n  const wholeX = width / 2;\n  const wholeY = 60;\n  const wholeRadius = 40;\n\n  const leftX = width / 2 - 70;\n  const leftY = 170;\n  const partRadius = 32;\n\n  const rightX = width / 2 + 70;\n  const rightY = 170;\n\n  const drawBubble = (cx\x2C cy\x2C r\x2C val\x2C isMissing\x2C fill\x2C stroke) => {\n    const strokeDash = isMissing ? 'stroke-dasharray="6\x2C4"' : '';\n    const displayVal = isMissing ? '?' : val;\n    const fontColor = isMissing ? '#ef4444' : '#1e293b';\n    const finalStroke = isMissing ? '#ef4444' : stroke;\n    const finalFill = isMissing ? '#fef2f2' : fill;\n\n    return `\n      <g>\n        <circle cx="${cx}" cy="${cy}" r="${r}" fill="${finalFill}" stroke="${finalStroke}" stroke-width="3" ${strokeDash} filter="url(#shadow)" />\n        <text x="${cx}" y="${cy + (r * 0.2) + 2}" font-family="system-ui\x2C sans-serif" font-size="${r * 0.7}px" font-weight="900" fill="${fontColor}" text-anchor="middle" style="user-select: none;">\n          ${displayVal}\n        </text>\n      </g>\n    `;\n  };\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: 360px; display: block; margin: 10px auto;">\n      ${SVG_DEFS}\n      <g>\n        <!-- Connecting lines -->\n        <line x1="${wholeX}" y1="${wholeY}" x2="${leftX}" y2="${leftY}" stroke="#94a3b8" stroke-width="4.5" stroke-linecap="round" />\n        <line x1="${wholeX}" y1="${wholeY}" x2="${rightX}" y2="${rightY}" stroke="#94a3b8" stroke-width="4.5" stroke-linecap="round" />\n        \n        <!-- Whole Bubble -->\n        ${drawBubble(wholeX\x2C wholeY\x2C wholeRadius\x2C wholeVal\x2C missing === 'whole'\x2C '#eff6ff'\x2C '#2563eb')}\n        \n        <!-- Left Part Bubble -->\n        ${drawBubble(leftX\x2C leftY\x2C partRadius\x2C leftVal\x2C missing === 'left'\x2C '#f0fdf4'\x2C '#16a34a')}\n        \n        <!-- Right Part Bubble -->\n        ${drawBubble(rightX\x2C rightY\x2C partRadius\x2C rightVal\x2C missing === 'right'\x2C '#f0fdf4'\x2C '#16a34a')}\n      </g>\n    </svg>\n  `.trim();\n}\n
