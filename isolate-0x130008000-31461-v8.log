code-creation,Script,9,301792,0x2595f6a732a0,54, file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/AnalogClock.js:1:1,0x187db225b880,~
script-source,564,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/AnalogClock.js,import { SVG_DEFS } from './defs.js';\n\nexport function renderAnalogClock(props) {\n  const initialHour = Math.max(1\x2C Math.min(12\x2C Number(props.hour) || 12));\n  const initialMinute = Math.max(0\x2C Math.min(59\x2C Number(props.minute) || 0));\n  const interactive = props.interactive === true || props.interactive === 'true' || props.interactive === 1;\n\n  const width = 240;\n  const extraHeight = interactive ? 60 : 0;\n  const height = width + extraHeight;\n  const cx = width / 2;\n  const cy = width / 2;\n  const r = width / 2 - 15;\n\n  // Calculate angles\n  // Minute hand: 6 deg per minute\n  // Hour hand: 30 deg per hour + 0.5 deg per minute\n  const getAngles = (h\x2C m) => {\n    const minAngle = m * 6;\n    const hrAngle = (h % 12) * 30 + m * 0.5;\n    return { hrAngle\x2C minAngle };\n  };\n\n  const { hrAngle\x2C minAngle } = getAngles(initialHour\x2C initialMinute);\n\n  // Draw hour markers (1 to 12)\n  let markers = '';\n  for (let i = 1; i <= 12; i++) {\n    const angleRad = (i * 30 * Math.PI) / 180 - Math.PI / 2;\n    const mx = cx + (r - 18) * Math.cos(angleRad);\n    const my = cy + (r - 18) * Math.sin(angleRad);\n\n    markers += `\n      <text x="${mx}" y="${my + 4}" font-family="system-ui\x2C sans-serif" font-size="14px" font-weight="900" fill="#1e293b" text-anchor="middle" style="user-select: none;">\n        ${i}\n      </text>\n    `;\n\n    // Minor minute ticks\n    for (let j = 1; j < 5; j++) {\n      const minAngleRad = ((i * 30 - j * 6) * Math.PI) / 180 - Math.PI / 2;\n      const tx1 = cx + (r - 6) * Math.cos(minAngleRad);\n      const ty1 = cy + (r - 6) * Math.sin(minAngleRad);\n      const tx2 = cx + r * Math.cos(minAngleRad);\n      const ty2 = cy + r * Math.sin(minAngleRad);\n      markers += `<line x1="${tx1}" y1="${ty1}" x2="${tx2}" y2="${ty2}" stroke="#94a3b8" stroke-width="1.5" />`;\n    }\n  }\n\n  let controls = '';\n  if (interactive) {\n    const btnY = width + 10;\n    const btnH = 34;\n\n    controls = `\n      <!-- Time state holders -->\n      <g id="clock-state" data-hour="${initialHour}" data-min="${initialMinute}"></g>\n      \n      <!-- Hour Adjust buttons -->\n      <g style="cursor: pointer;" onclick="\n        var state = this.parentNode.querySelector('#clock-state');\n        var h = parseInt(state.getAttribute('data-hour'));\n        var m = parseInt(state.getAttribute('data-min'));\n        \n        h = h === 12 ? 1 : h + 1;\n        state.setAttribute('data-hour'\x2C h);\n        \n        var hrHand = this.ownerSVGElement.querySelector('.hour-hand');\n        var hrAngle = (h % 12) * 30 + m * 0.5;\n        hrHand.setAttribute('transform'\x2C 'rotate(' + hrAngle + '\x2C ${cx}\x2C ${cy})');\n        \n        var timeStr = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);\n        var input = document.querySelector('.responsive-input input') || document.querySelector('input[type=text]') || document.getElementById('ans') || document.querySelector('input');\n        if (input) {\n          input.value = timeStr;\n          input.dispatchEvent(new Event('input'\x2C { bubbles: true }));\n        }\n      ">\n        <rect x="15" y="${btnY}" width="95" height="${btnH}" rx="8" fill="#3b82f6" stroke="#2563eb" stroke-width="1" />\n        <text x="62.5" y="${btnY + btnH/2 + 5}" font-family="system-ui\x2C sans-serif" font-size="11px" font-weight="800" fill="#ffffff" text-anchor="middle" style="user-select: none;">+1 Hour</text>\n      </g>\n      \n      <!-- Minute Adjust buttons -->\n      <g style="cursor: pointer;" onclick="\n        var state = this.parentNode.querySelector('#clock-state');\n        var h = parseInt(state.getAttribute('data-hour'));\n        var m = parseInt(state.getAttribute('data-min'));\n        \n        m = (m + 5) % 60;\n        if (m === 0) {\n          h = h === 12 ? 1 : h + 1;\n          state.setAttribute('data-hour'\x2C h);\n        }\n        state.setAttribute('data-min'\x2C m);\n        \n        var hrHand = this.ownerSVGElement.querySelector('.hour-hand');\n        var minHand = this.ownerSVGElement.querySelector('.minute-hand');\n        \n        var hrAngle = (h % 12) * 30 + m * 0.5;\n        var minAngle = m * 6;\n        \n        hrHand.setAttribute('transform'\x2C 'rotate(' + hrAngle + '\x2C ${cx}\x2C ${cy})');\n        minHand.setAttribute('transform'\x2C 'rotate(' + minAngle + '\x2C ${cx}\x2C ${cy})');\n        \n        var timeStr = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);\n        var input = document.querySelector('.responsive-input input') || document.querySelector('input[type=text]') || document.getElementById('ans') || document.querySelector('input');\n        if (input) {\n          input.value = timeStr;\n          input.dispatchEvent(new Event('input'\x2C { bubbles: true }));\n        }\n      ">\n        <rect x="130" y="${btnY}" width="95" height="${btnH}" rx="8" fill="#10b981" stroke="#059669" stroke-width="1" />\n        <text x="177.5" y="${btnY + btnH/2 + 5}" font-family="system-ui\x2C sans-serif" font-size="11px" font-weight="800" fill="#ffffff" text-anchor="middle" style="user-select: none;">+5 Mins</text>\n      </g>\n    `;\n  }\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: ${width}px; display: block; margin: 10px auto;">\n      ${SVG_DEFS}\n      \n      <!-- Outer clock body -->\n      <circle cx="${cx}" cy="${cy}" r="${r}" fill="#f8fafc" stroke="#cbd5e1" stroke-width="6" filter="url(#shadow)" />\n      <circle cx="${cx}" cy="${cy}" r="${r - 8}" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />\n      \n      <!-- Hour markings -->\n      ${markers}\n      \n      <!-- Hands -->\n      <g>\n        <!-- Hour Hand (Shorter\x2C Thicker) -->\n        <line class="hour-hand" x1="${cx}" y1="${cy + 8}" x2="${cx}" y2="${cy - r + 38}" stroke="#0f172a" stroke-width="5" stroke-linecap="round" transform="rotate(${hrAngle}\x2C ${cx}\x2C ${cy})" />\n        \n        <!-- Minute Hand (Longer\x2C Thinner) -->\n        <line class="minute-hand" x1="${cx}" y1="${cy + 12}" x2="${cx}" y2="${cy - r + 18}" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" transform="rotate(${minAngle}\x2C ${cx}\x2C ${cy})" />\n        \n        <!-- Pin center -->\n        <circle cx="${cx}" cy="${cy}" r="6" fill="#0f172a" />\n        <circle cx="${cx}" cy="${cy}" r="2.5" fill="#facc15" />\n      </g>\n      \n      ${controls}\n    </svg>\n  `.trim();\n}\n
