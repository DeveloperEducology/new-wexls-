script-source,512,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/defs.js,// Color palettes for premium styling\nexport const COLORS = {\n  red: { fill: 'url(#redGrad)'\x2C stroke: '#b91c1c' }\x2C\n  blue: { fill: 'url(#blueGrad)'\x2C stroke: '#1d4ed8' }\x2C\n  green: { fill: 'url(#greenGrad)'\x2C stroke: '#047857' }\x2C\n  yellow: { fill: 'url(#yellowGrad)'\x2C stroke: '#a16207' }\x2C\n  pink: { fill: 'url(#pinkGrad)'\x2C stroke: '#be185d' }\x2C\n  purple: { fill: 'url(#purpleGrad)'\x2C stroke: '#6d28d9' }\x2C\n  orange: { fill: 'url(#orangeGrad)'\x2C stroke: '#c2410c' }\x2C\n  black: { fill: 'url(#blackGrad)'\x2C stroke: '#1e293b' }\n};\n\nexport const FLAT_COLORS = {\n  red: { fill: '#fee2e2'\x2C stroke: '#dc2626' }\x2C\n  blue: { fill: '#dbeafe'\x2C stroke: '#1d4ed8' }\x2C\n  green: { fill: '#dcfce7'\x2C stroke: '#15803d' }\x2C\n  yellow: { fill: '#fef9c3'\x2C stroke: '#ca8a04' }\x2C\n  pink: { fill: '#fce7f3'\x2C stroke: '#db2777' }\x2C\n  purple: { fill: '#f3e8ff'\x2C stroke: '#7c3aed' }\x2C\n  orange: { fill: '#ffedd5'\x2C stroke: '#ea580c' }\x2C\n  black: { fill: '#e2e8f0'\x2C stroke: '#1e293b' }\n};\n\n// SVG Gradients Definition Block to include in generated SVGs\nexport const SVG_DEFS = `\n  <defs>\n    <radialGradient id="redGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#fca5a5" />\n      <stop offset="70%" stop-color="#ef4444" />\n      <stop offset="100%" stop-color="#991b1b" />\n    </radialGradient>\n    <radialGradient id="blueGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#93c5fd" />\n      <stop offset="70%" stop-color="#3b82f6" />\n      <stop offset="100%" stop-color="#1e3a8a" />\n    </radialGradient>\n    <radialGradient id="greenGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#86efac" />\n      <stop offset="70%" stop-color="#10b981" />\n      <stop offset="100%" stop-color="#064e3b" />\n    </radialGradient>\n    <radialGradient id="yellowGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#fef08a" />\n      <stop offset="70%" stop-color="#eab308" />\n      <stop offset="100%" stop-color="#854d0e" />\n    </radialGradient>\n    <radialGradient id="pinkGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#fbcfe8" />\n      <stop offset="70%" stop-color="#ec4899" />\n      <stop offset="100%" stop-color="#9d174d" />\n    </radialGradient>\n    <radialGradient id="purpleGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#ddd6fe" />\n      <stop offset="70%" stop-color="#8b5cf6" />\n      <stop offset="100%" stop-color="#5b21b6" />\n    </radialGradient>\n    <radialGradient id="orangeGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#fed7aa" />\n      <stop offset="70%" stop-color="#f97316" />\n      <stop offset="100%" stop-color="#9a3412" />\n    </radialGradient>\n    <radialGradient id="blackGrad" cx="30%" cy="30%" r="70%">\n      <stop offset="0%" stop-color="#cbd5e1" />\n      <stop offset="70%" stop-color="#475569" />\n      <stop offset="100%" stop-color="#0f172a" />\n    </radialGradient>\n    \n    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">\n      <feDropShadow dx="2" dy="2" stdDeviation="2" flood-opacity="0.3"/>\n    </filter>\n  </defs>\n`;\n\nexport function resolveColor(color\x2C palette = FLAT_COLORS\x2C rng = null) {\n  let resolvedColor = color || 'blue';\n  if (resolvedColor === 'random') {\n    const keys = Object.keys(palette);\n    if (rng) {\n      resolvedColor = keys[Math.floor(rng() * keys.length)];\n    } else {\n      resolvedColor = keys[Math.floor(Math.random() * keys.length)];\n    }\n  }\n  return palette[resolvedColor] || Object.values(palette)[0];\n}\n
