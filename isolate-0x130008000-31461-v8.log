code-creation,Script,9,302167,0x2595f6a73380,54, file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/Calendar.js:1:1,0x187db225cc20,~
script-source,566,file:///Users/vijay/Desktop/antigravity/new%20wexls/src/lib/practice/generators/universal/components/Calendar.js,import { SVG_DEFS } from './defs.js';\n\nexport function renderCalendar(props) {\n  const month = props.month || 'October';\n  const daysInMonth = Math.max(28\x2C Math.min(31\x2C Number(props.daysInMonth) || 31));\n  const startDay = Math.max(0\x2C Math.min(6\x2C Number(props.startDay) || 2)); // 0 = Sunday\x2C 6 = Saturday\n  const highlightDays = props.highlightDays ? String(props.highlightDays).split('\x2C').map(Number).filter(n => !isNaN(n)) : [];\n\n  const width = 360;\n  const headerHeight = 45;\n  const daysHeaderHeight = 30;\n  const cellWidth = 46;\n  const cellHeight = 36;\n  const paddingX = 19;\n  \n  // Max weeks in a month can be 6\n  const totalCells = startDay + daysInMonth;\n  const weeksCount = Math.ceil(totalCells / 7);\n  const gridHeight = weeksCount * cellHeight;\n  \n  const height = headerHeight + daysHeaderHeight + gridHeight + 25;\n\n  // Render Month Name\n  let calendarMarkup = `\n    <!-- Top Month Header Background -->\n    <path d="M 10 10 L 350 10 A 12 12 0 0 1 350 50 L 10 50 A 12 12 0 0 1 10 10 Z" fill="#eff6ff" stroke="#cbd5e1" stroke-width="1.5" />\n    <text x="${width / 2}" y="${34}" font-family="system-ui\x2C sans-serif" font-size="16px" font-weight="900" fill="#1e3a8a" text-anchor="middle">${month}</text>\n  `;\n\n  // Render Weekday Labels (S\x2C M\x2C T\x2C W\x2C T\x2C F\x2C S)\n  const weekdays = ['Su'\x2C 'Mo'\x2C 'Tu'\x2C 'We'\x2C 'Th'\x2C 'Fr'\x2C 'Sa'];\n  const dayY = headerHeight + 20;\n\n  for (let i = 0; i < 7; i++) {\n    const x = paddingX + i * cellWidth + cellWidth / 2;\n    calendarMarkup += `\n      <text x="${x}" y="${dayY}" font-family="system-ui\x2C sans-serif" font-size="12px" font-weight="800" fill="#64748b" text-anchor="middle">${weekdays[i]}</text>\n    `;\n  }\n\n  // Render Days Grid\n  let daysMarkup = '';\n  let dayNum = 1;\n  const startY = headerHeight + daysHeaderHeight + 10;\n\n  for (let w = 0; w < weeksCount; w++) {\n    for (let d = 0; d < 7; d++) {\n      const cellIdx = w * 7 + d;\n      \n      if (cellIdx >= startDay && dayNum <= daysInMonth) {\n        const x = paddingX + d * cellWidth;\n        const y = startY + w * cellHeight;\n        const isHighlighted = highlightDays.includes(dayNum);\n\n        const circleFill = isHighlighted ? '#f87171' : 'none';\n        const textWeight = isHighlighted ? '900' : '700';\n        const textCol = isHighlighted ? '#ffffff' : '#334155';\n\n        daysMarkup += `\n          <g>\n            <rect x="${x}" y="${y}" width="${cellWidth}" height="${cellHeight}" fill="none" />\n            ${isHighlighted ? `\n              <circle cx="${x + cellWidth / 2}" cy="${y + cellHeight / 2 - 2}" r="14" fill="${circleFill}" filter="url(#shadow)" />\n            ` : ''}\n            <text x="${x + cellWidth / 2}" y="${y + cellHeight / 2 + 3}" font-family="system-ui\x2C sans-serif" font-size="12px" font-weight="${textWeight}" fill="${textCol}" text-anchor="middle" style="user-select: none;">\n              ${dayNum}\n            </text>\n          </g>\n        `;\n        dayNum++;\n      }\n    }\n  }\n\n  return `\n    <svg viewBox="0 0 ${width} ${height}" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: 360px; display: block; margin: 10px auto;" filter="url(#shadow)">\n      ${SVG_DEFS}\n      <!-- Calendar Backing Card -->\n      <rect x="10" y="10" width="${width - 20}" height="${height - 20}" rx="12" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />\n      \n      ${calendarMarkup}\n      ${daysMarkup}\n    </svg>\n  `.trim();\n}\n
