code-creation,Eval,9,34417,0x316546c15e8,5, /Users/vijay/Desktop/antigravity/new wexls/scratch/inspect_action_verb.js:1:1,0x3e47a801c440,~
script-source,76,/Users/vijay/Desktop/antigravity/new wexls/scratch/inspect_action_verb.js,const { getMongoDb\x2C hasMongoConfig } = require('../src/lib/db/mongo.js');\nconst { seededRandom } = require('../src/lib/practice/generators/universal/evaluator.js');\nconst { resolveExpression } = require('../src/lib/practice/generators/universal/expressionParser.js');\n\nasync function main() {\n  if (!hasMongoConfig()) {\n    console.log('No Mongo config!');\n    return;\n  }\n  const db = await getMongoDb();\n  \n  const template = await db.collection('dynamic_templates').findOne({ id: 'template-find-the-action-verb' });\n  if (!template) {\n    console.log('Template not found!');\n    return;\n  }\n\n  const context = {};\n  console.log('Evaluating variables step-by-step:');\n  \n  for (const variable of template.variables) {\n    const start = Date.now();\n    let val;\n    if (variable.type === 'expression') {\n      val = resolveExpression(variable.formula\x2C context);\n    } else if (variable.type === 'array') {\n      val = variable.values;\n    } else {\n      val = variable.value;\n    }\n    context[variable.name] = val;\n    const end = Date.now();\n    console.log(`Variable "${variable.name}" took ${end - start}ms to resolve. Value:`\x2C JSON.stringify(val));\n  }\n}\n\nmain().then(() => process.exit(0));\n
